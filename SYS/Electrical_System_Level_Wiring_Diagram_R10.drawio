        <mxCell id="dooract" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6510;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=11;" value="&lt;b&gt;Door 12 V actuator set&lt;/b&gt; · to be defined by Adherent360 · placeholder: SYSCTRL spare 12 V H-bridge outputs, Micro-Fit 2-pin each" vertex="1">
