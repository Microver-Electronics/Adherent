45" value="&lt;b&gt;J2 · RJ45 panel adapter&lt;/b&gt;&lt;br&gt;McMaster-Carr 1422N13&lt;br&gt;Shielded Cat5e F/F · rear panel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="240" height="80" as="geometry" /></mxCell><mxCell id="tag_rj45" value="CONN" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="rj45"><mxGeometry x="6" y="3" width="52" height="17" as="geometry" /></mxCell><mxCell id="lan" value="&lt;b&gt;LAN · pharmacy LAN / router&lt;/b&gt; · site equipment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F9;strokeColor=#1D5FA8;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=0;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="265" width="500" height="50" as="geometry" /></mxCell><mxCell id="ipad" value="&lt;b&gt;IPAD · iPad&lt;/b&gt; (not integrated)&lt;br&gt;Adherent app / web browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=0;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="240" height="90" as="geometry" /></mxCell><mxCell id="cloud" value="&lt;b&gt;CLOUD · Adherent servers&lt;/b&gt;&lt;br&gt;internet · vend API" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="345" width="240" height="120" as="geometry" /></mxCell><mxCell id="g_power" value="AC INPUT &amp; SINGLE 24 V POWER SUPPLY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F0EE;strokeColor=#BE3A2B;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#BE3A2B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="540" height="330" as="geometry" /></mxCell><mxCell id="acin" value="&lt;b&gt;J1 · AC inlet · EMI filter · main breaker&lt;/b&gt;&lt;br&gt;120 / 230 VAC · IEC C14 + PE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="500" height="60" as="geometry" /></mxCell><mxCell id="tag_acin" value="CONN" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="acin"><mxGeometry x="6" y="3" width="52" height="17" as="geometry" /></mxCell><mxCell id="psu24" value="&lt;b&gt;PSU1 · Mean Well RSP-500-24&lt;/b&gt;&lt;br&gt;24 V · 21 A · 504 W rated · single system AC/DC PSU&lt;br&gt;&lt;font color=&quot;#6B737C&quot;&gt;Full load / thermal budget remains HOLD&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=0;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="500" height="100" as="geometry" /></mxCell><mxCell id="pwr_note" value="W37: protective-earth bonding to PSU FG and exposed metal · plan pending.&lt;br&gt;24 V → 12 V is generated only on SYSCTRL; no separate distribution assembly or external 24 → 12 V module." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="500" height="55" as="geometry" /></mxCell><mxCell id="g_nfc" value="NFC · ANTENNA SELECTED · READER BOARD R1 IN DESIGN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3EEF9;strokeColor=#7356A0;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#7356A0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="540" height="385" as="geometry" /></mxCell><mxCell id="nfc_antenna" value="&lt;b&gt;ANT-NFC · Molex 1462362151&lt;/b&gt;&lt;br&gt;13.56 MHz · 15 × 15 mm&lt;br&gt;102 mm cable · adhesive&lt;br&gt;&lt;font color=&quot;#6B737C&quot;&gt;Selected · 1 per machine planned&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7356A0;strokeWidth=1.5;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=0;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="210" height="125" as="geometry" /></mxCell><mxCell id="nfc_pcb" value="&lt;b&gt;NFC · HW_ADHERENT_NFC_R1&lt;/b&gt;&lt;br&gt;Custom PCB · reader board&lt;br&gt;STM32F103C8 + ST25R200&lt;br&gt;CAN node · 24 V + CAN in&lt;br&gt;4-pin Micro-Fit (J1)&lt;br&gt;&lt;font color=&quot;#6B737C&quot;&gt;R1 schematic / layout in progress&lt;br&gt;Not a payment terminal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7356A0;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="950" width="250" height="170" as="geometry" /></mxCell><mxCell id="tag_nfc_pcb" value="PCB" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="nfc_pcb"><mxGeometry x="6" y="3" width="52" height="17" as="geometry" /></mxCell><mxCell id="nfc_note" value="System wiring of the NFC board is &lt;b&gt;TBC&lt;/b&gt;: CAN bus position and node ID, 24 V feed branch and fuse, mounting / reading position. No W / F reference is assigned yet, so no harness is drawn.&lt;br&gt;Matching / RF termination to the antenna is on the NFC board." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="1135" width="500" height="140" as="geometry" /></mxCell><mxCell id="g_cab" value="CONTROL CABINET · base compartment (behind AVM-BASE-COVER)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="600" height="1185" as="geometry" /></mxCell><mxCell id="sbc" value="&lt;b&gt;MAINCTRL · MYIR MYD-YF13X · COTS ×1&lt;/b&gt;&lt;br&gt;HW_ADHERENT_MAINCTRL_R1 · FW_ADHERENT_MAINCTRL_R1&lt;br&gt;STM32MP135 / Linux · supervisory application&lt;br&gt;CAN master to SYSCTRL / lanes · RS485 master to IOCTRL-01 / -02&lt;br&gt;12 V from SYSCTRL via F13 / W05 · native MYIR connectors&lt;br&gt;&lt;font color=&quot;#6B737C&quot;&gt;Exact SKU, populated interfaces and BSP TBC&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="145" width="520" height="150" as="geometry" /></mxCell><mxCell id="tag_sbc" value="PCB" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="sbc"><mxGeometry x="6" y="3" width="52" height="17" as="geometry" /></mxCell><mxCell id="motion" value="&lt;b&gt;SYSCTRL · custom STM32 machine controller ×1&lt;/b&gt;&lt;br&gt;HW_ADHERENT_SYSCTRL_R1 · FW_ADHERENT_SYSCTRL_R1&lt;br&gt;Gantry: STEP / DIR / ENA, ALARM, brakes (interfaces TBC)&lt;br&gt;Servo: PWM + local regulator (voltage / current TBC)&lt;br&gt;Labeling: chuck / jaw motor drivers + jaw home sensor&lt;br&gt;6 gantry sensors direct · CAN node · status light W36" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=6;verticalAlign=top;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="690" y="345" width="520" height="570" as="geometry" /></mxCell><mxCell id="tag_motion" value="PCB" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="motion"><mxGeometry x="6" y="3" width="52" height="17" as="geometry" /></mxCell><mxCell id="sysctrl_buck" value="&lt;b&gt;BUCK12 · onboard SMPS 24 V → 12 V&lt;/b&gt; · rating / implementation TBC&lt;br&gt;Feeds MAINCTRL, local logic / servo / sensors and latch contacts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4EE;strokeColor=#BE3A2B;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=11;spacing=6;spacingTop=0;verticalAlign=middle;" vertex="1" parent="motion"><mxGeometry x="20" y="160" width="480" height="60" as="geometry" /></mxCell><mxCell id="dist" value="&lt;b&gt;SYSCTRL-PWR · SYSCTRL power connectors&lt;/b&gt;&lt;br&gt;24 V input from PSU1 (W03)&lt;br&gt;24 V out: lane rows F1–F10 · X / Z drives F15 / F16 (TBC) · IOCTRL F17&lt;br&gt;12 V out: MAINCTRL F13 · IOCTRL relay COM F18&lt;br&gt;F1–F18 are branch references; protection implementation TBC&lt;br&gt;&lt;font color=&quot;#6B737C&quot;&gt;Connectors on the SYSCTRL PCB, not a separate distribution assembly&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFAF8;strokeColor=#BE3A2B;strokeWidth=1.5;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=18;verticalAlign=middle;" vertex="1" parent="motion"><mxGeometry x="0" y="250" width="520" height="320" as="geometry" /></mxCell><mxCell id="tag_dist" value="CONN" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="dist"><mxGeometry x="6" y="3" width="52" height="17" as="geometry" /></mxCell><mxCell id="ioctrl_02_stack" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F9;strokeColor=#1D5FA8;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=0;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="698" y="983" width="520" height="150" as="geometry" /></mxCell><mxCell id="ioctrl" value="&lt;b&gt;IOCTRL-01 / IOCTRL-02 · Waveshare ESP32-S3-ETH-8DI-8RO · COTS ×2&lt;/b&gt;&lt;br&gt;24 V module supply via F17 / W34, each module · rated input 7–36 V&lt;br&gt;Relay COM: SYSCTRL-derived 12 V via F18 / W35&lt;br&gt;Isolated RS485 to MAINCTRL · two addresses, shared bus TBC · Modbus RTU to verify&lt;br&gt;RO1–4: latches · DI1–5: door sensors · split across modules TBC&lt;br&gt;&lt;font color=&quot;#6B737C&quot;&gt;Wi-Fi / BLE / Ethernet unused&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F9;strokeColor=#1D5FA8;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="975" width="520" height="150" as="geometry" /></mxCell><mxCell id="tag_ioctrl" value="PCB" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="ioctrl"><mxGeometry x="6" y="3" width="52" height="17" as="geometry" /></mxCell><mxCell id="stacklight" value="&lt;b&gt;STACK · 12 V status light&lt;/b&gt;&lt;br&gt;MPN TBC · W36 direct from SYSCTRL · route TBC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#394047;strokeWidth=1.5;dashed=0;fontFamily=Helvetica;fontSize=11;spacing=6;spacingTop=0;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="1165" width="250" height="60" as="geometry" /></mxCell><mxCell id="cab_note" value="Sensors are wired directly to controller boards; no junction boxes.&lt;br&gt;CAN backbone: MAINCTRL → SYSCTRL → LANECTRL-10 → … → LANECTRL-01 · two end terminations · 500 kbit/s planning bitrate." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="955" y="1160" width="270" height="115" as="geometry" /></mxCell><mxCell id="g_gantry" value="GANTRY · 6 direct sensor runs to SYSCTRL · igus chains X 762 mm / Z 1616 mm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="660" height="445" as="geometry" /></mxCell><mxCell id="xstep" value="&lt;b&gt;X · closed-loop stepper + supplied driver&lt;/b&gt; · Emtech 57BYG250-76 · 2 N·m · 4 A · brake · X-GB 3:1 gearbox&lt;br&gt;&lt;font color=&quot;#6B737C&quot;&gt;24 V input proposed, supplier confirmation required · STEP / DIR / ENA in · ALARM out · brake 24 V (TBC)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;dashed=0;fontFamily=Helvetica;fontSize=12;spacing=6;spacingTop=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1425" y="145" width="610" height="80" as="geometry" /></mxCell><mxCell id="tag_xstep" value="MTR" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="xstep"><mxGeometry x="6" y="3" width="52" height="17" as="geometry" /></mxCell><mxCell id="zstep" value="&lt;b&gt;Z · closed-loop stepper + supplied driver&lt;/b&gt; · Emtech 57BYG250-76 · 2 N·m · 4 A · brake holds carriage&lt;br&gt;&lt;font color=&quot;#6B737C&quot;&