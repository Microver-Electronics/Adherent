<mxfile host="Electron" agent="Blackocean Technologies"><diagram id="esl-wiring" name="Electrical System Level Wiring Diagram"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3240" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Electrical System Level Wiring Diagram&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52616d&quot;&gt;Adherent360 APDU / AVM · Blackocean Technologies · 10 rows × 7 lanes = 70 conveyors · &lt;b&gt;R27&lt;/b&gt; · 2026-09-24 · design review baseline&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="60" as="geometry" /></mxCell><mxCell id="g_net" value="NETWORK / USER ACCESS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F9;strokeColor=#1D5FA8;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1D5FA8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="430" as="geometry" /></mxCell><mxCell id="rj45" value="&lt;b&gt;J2 · RJ45 panel adapter&lt;/b&gt;&lt;br&gt;McMaster-Carr 1422N13&lt;br&gt;Shielded Cat5e F/F · rear panel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="220" height="80" as="geometry" /></mxCell><mxCell id="wifi" value="&lt;b&gt;Wi-Fi / BT antenna&lt;/b&gt;&lt;br&gt;bulkhead RP-SMA&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;USB Wi-Fi / BT module on MAINCTRL, optional&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="310" y="160" width="220" height="80" as="geometry" /></mxCell><mxCell id="lan" value="&lt;b&gt;Pharmacy LAN / router&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F9;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="460" height="60" as="geometry" /></mxCell><mxCell id="ipad" value="&lt;b&gt;iPad&lt;/b&gt; (not integrated)&lt;br&gt;Adherent app / web browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="220" height="90" as="geometry" /></mxCell><mxCell id="cloud" value="&lt;b&gt;Adherent servers&lt;/b&gt;&lt;br&gt;internet · vend API" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="380" width="220" height="130" as="geometry" /></mxCell><mxCell id="g_power" value="AC INPUT &amp;amp; SINGLE 24 V POWER SUPPLY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F0EE;strokeColor=#BE3A2B;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#BE3A2B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="520" height="500" as="geometry" /></mxCell><mxCell id="acin" value="&lt;b&gt;AC inlet · EMI filter · main breaker&lt;/b&gt;&lt;br&gt;120 / 230 VAC · IEC C14 + PE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="460" height="70" as="geometry" /></mxCell><mxCell id="psu24" value="&lt;b&gt;PSU1 · Mean Well RSP-500-24&lt;/b&gt;&lt;br&gt;24 V · 21 A · 504 W rated&lt;br&gt;Single system AC/DC PSU&lt;br&gt;Full load / thermal budget remains HOLD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="770" width="460" height="100" as="geometry" /></mxCell><mxCell id="pwr_note" value="&lt;b&gt;One onboard SMPS converts 24 V to 12 V on SYSCTRL.&lt;/b&gt;&lt;br&gt;PSU1 feeds SYSCTRL; the lower connector area belongs to the same PCB.&lt;br&gt;No separate distribution assembly or external 24→12 V module.&lt;br&gt;W37: protective-earth bonding to PSU FG and exposed metal; plan pending." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="925" width="460" height="100" as="geometry" /></mxCell><mxCell id="g_cab" value="CONTROL CABINET · base compartment (behind AVM-BASE-COVER)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="560" height="900" as="geometry" /></mxCell><mxCell id="sbc" value="&lt;b&gt;MAINCTRL · MYIR MYD-YF13X · COTS ×1&lt;/b&gt;&lt;br&gt;HW_ADHERENT_MAINCTRL_R1 · FW_ADHERENT_MAINCTRL_R1&lt;br&gt;STM32MP135 / Linux · supervisory application&lt;br&gt;CAN master to SYSCTRL / lanes · RS485 to IOCTRL&lt;br&gt;&lt;b&gt;12 V from SYSCTRL-derived rail via F13 / W05&lt;/b&gt;&lt;br&gt;Native MYIR power / CAN / RS485 connectors retained&lt;br&gt;Exact SKU, populated interfaces and BSP to be confirmed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="500" height="150" as="geometry" /></mxCell><mxCell id="motion" value="&lt;b&gt;SYSCTRL · custom STM32 machine controller ×1&lt;/b&gt;&lt;br&gt;HW_ADHERENT_SYSCTRL_R1 · FW_ADHERENT_SYSCTRL_R1&lt;br&gt;Gantry: STEP / DIR / ENA, ALARM, brakes (interfaces TBC)&lt;br&gt;Servo: PWM + local regulator; voltage / current TBC&lt;br&gt;Labeling: chuck / jaw motor drivers + jaw home sensor&lt;br&gt;&lt;b&gt;6 gantry sensors connect directly to SYSCTRL&lt;/b&gt;&lt;br&gt;CAN · stack light W36 · 24 V input · onboard 12 V generation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;verticalAlign=top;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="790" y="370" width="500" height="440" as="geometry" /></mxCell><mxCell id="sysctrl_buck" value="&lt;b&gt;ONBOARD SMPS · 24 V → 12 V&lt;/b&gt;&lt;br&gt;One conversion stage on SYSCTRL · rating / implementation TBC&lt;br&gt;MAINCTRL, local logic / servo / sensors, lane logic and latch contacts" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Helvetica;spacing=4;strokeColor=#BE3A2B;dashed=0;fillColor=#FFF4EE;fontSize=11;" vertex="1" parent="motion"><mxGeometry x="20" y="180" width="460" height="70" as="geometry" /></mxCell><mxCell id="dist" value="&lt;b&gt;SYSCTRL power connectors&lt;/b&gt;&lt;br&gt;24 V input from PSU1 · 24 V outputs: lanes, drives (TBC), IOCTRL&lt;br&gt;Derived 12 V outputs: MAINCTRL, lane logic and latch contacts&lt;br&gt;Branch references F1–F18 retained; protection implementation TBC&lt;br&gt;&lt;b&gt;These are SYSCTRL connections, not a separate distribution assembly.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;spacing=5;spacingTop=20;strokeColor=none;fillColor=none;" vertex="1" parent="motion"><mxGeometry x="0" y="320" width="500" height="120" as="geometry" /></mxCell><mxCell id="cab_note" value="Sensor wiring is direct to controller boards; no junction boxes.&lt;br&gt;CAN backbone: MAINCTRL → SYSCTRL → LANECTRL-10 → ... → LANECTRL-01.&lt;br&gt;Two end terminations only; 500 kbit/s is the planning bitrate." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="790" y="850" width="500" height="60" as="geometry" /></mxCell><mxCell id="g_gantry" value="GANTRY · 6 DIRECT SENSOR RUNS TO SYSCTRL · igus chains X 762 mm / Z 1616 mm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1640" y="110" width="640" height="320" as="geometry" /></mxCell><mxCell id="xstep" value="&lt;b&gt;X closed-loop stepper + supplied driver&lt;/b&gt;&lt;br&gt;Emtech 57BYG250-76 · 2 N·m · 4 A · brake · 3:1 gearbox&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;Proposed 24 V input: supplier confirmation required · STEP/DIR/ENA in · ALARM out · brake 24 V (TBC)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="1670" y="160" width="290" height="100" as="geometry" /></mxCell><mxCell id="zstep" value="&lt;b&gt;Z closed-loop stepper + supplied driver&lt;/b&gt;&lt;br&gt;Emtech 57BYG250-76 · 2 N·m · 4 A · brake holds carriage&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;Proposed 24 V input: supplier confirmation required · STEP/DIR/ENA in · ALARM out · brake 24 V (TBC)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="1990" y="160" width="290" height="100" as="geometry" /></mxCell><mxCell id="servo" value="&lt;b&gt;Basket tilt servo · Miuzei DS3218 ×1&lt;/b&gt;&lt;br&gt;Exact variant, travel and supply range TBC&lt;br&gt;Local regulator on SYSCTRL · W13&lt;br&gt;Stall/current limit and signal timing require verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="1670" y="300" width="290" height="100" as="geometry" /></mxCell><mxCell id="optos" value="&lt;b&gt;6 × Omron prewired sensors&lt;/b&gt;&lt;br&gt;X: EE-SX672-WR ×3 · Z: EE-SX674-WR ×3&lt;br&gt;&lt;b&gt;W15 direct to SYSCTRL J21–J26&lt;/b&gt;&lt;br&gt;1 m supplied leads; actual routes / lead arrangement TBC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1990" y="300" width="290" height="100" as="geometry" /></mxCell><mxCell id="g_station" value="LABELING MECHANISM (motor group 2) · laser platform assembly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1640" y="490" width="640" height="300" as="geometry" /></mxCell><mxCell id="chuck" value="&lt;b&gt;Chuck rotate stepper&lt;/b&gt;&lt;br&gt;NEMA23 + gearbox (6627T113) · 4-wire" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="1670" y="540" width="290" height="90" as="geometry" /></mxCell><mxCell id="jaws" value="&lt;b&gt;Chuck jaw stepper&lt;/b&gt;&lt;br&gt;NEMA11 (6627T357) · T5 belt · 4-wire&lt;br&gt;+ jaw home sensor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="1990" y="540" width="290" height="90" as="geometry" /></mxCell><mxCell id="camq" value="&lt;b&gt;Camera / OCR · excluded pending decision&lt;/b&gt;&lt;br&gt;Purpose, model and interface not selected&lt;br&gt;No committed camera power or cable allocation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6510;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="670" width="290" height="90" as="geometry" /></mxCell><mxCell id="printer" value="&lt;b&gt;Label marker · model / interface TBC&lt;/b&gt;&lt;br&gt;W19: data interface pending&lt;br&gt;W39: supply and protection pending&lt;br&gt;No extra AC/DC PSU assumed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6510;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1990" y="670" width="290" height="90" as="geometry" /></mxCell><mxCell id="g_doors" value="DOORS &amp;amp; LATCHES · IOCTRL · DIRECT SENSOR WIRING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1640" y="850" width="640" height="400" as="geometry" /></mxCell><mxCell id="ioctrl" value="&lt;b&gt;IOCTRL · Waveshare ESP32-S3-ETH-8DI-8RO · COTS ×1&lt;/b&gt;&lt;br&gt;&lt;b&gt;Module power: 24 V via F17 / W34&lt;/b&gt; · rated input 7–36 V&lt;br&gt;MAINCTRL ↔ isolated RS485 · planned Modbus RTU firmware&lt;br&gt;&lt;b&gt;Relay COM supply: SYSCTRL-derived 12 V via F18 / W35&lt;/b&gt;&lt;br&gt;RO1–4: latches · DI1–5: door sensors · RO5–8: reserved · Wi-Fi / BLE / Ethernet unused" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Helvetica;spacing=4;fillColor=#EEF3F9;strokeColor=#1D5FA8;fontSize=12;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="1670" y="900" width="610" height="120" as="geometry" /></mxCell><mxCell id="latches" value="&lt;b&gt;4 × 12 V latch · K1–K4&lt;/b&gt;&lt;br&gt;Main · retrieval · return · table&lt;br&gt;W20/W21 from IOCTRL RO1–RO4&lt;br&gt;MPN, duty, suppression and fail behavior TBC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="1080" width="290" height="85" as="geometry" /></mxCell><mxCell id="doorsens" value="&lt;b&gt;5 × door sensor · reed / microswitch TBC&lt;/b&gt;&lt;br&gt;Main · retrieval · return · table · front access&lt;br&gt;&lt;b&gt;W23 direct to IOCTRL DI1–DI5&lt;/b&gt;&lt;br&gt;Lead lengths and DI reference / polarity TBC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1990" y="1080" width="290" height="85" as="geometry" /></mxCell><mxCell id="dooract" value="&lt;b&gt;Door actuators:&lt;/b&gt; excluded until defined · W28 quantity 0 · RO5–RO8 reserved; no reversing circuit approved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6510;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="1190" width="610" height="40" as="geometry" /></mxCell><mxCell id="g_lanes" value="LANE ROWS · 10 rows × 7 lanes · HW_ADHERENT_LANECTRL_R1 ×10 (FW_ADHERENT_LANECTRL_R1) · buttons + LEDs on board · 24 V bus bar = F1–F10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2500" y="110" width="700" height="1150" as="geometry" /></mxCell><mxCell id="busbar" value="" style="rounded=0;html=1;fillCo