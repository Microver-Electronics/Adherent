    <mxCell id="lane_note" value="Per row: LANECTRL sits in the rear 2&quot; channel and IS the junction box. 7 short 3-pin conveyor leads plug in locally (drawer-slide rows: service loop or blind-mate connector at the slide). Row cable count: 7 internal + 2 external." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1020" y="650" width="400" height="90" as="geometry"/></mxCell>
    <mxCell id="lane_note2" value="Lane n → row = n ÷ 7, channel = n mod 7. Only one lane runs at a time in normal dispense; feeder fuse sized for one lane stall + idle." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="400" height="60" as="geometry"/></mxCell>
