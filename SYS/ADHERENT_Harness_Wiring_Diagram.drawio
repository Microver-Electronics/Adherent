" value="LAMP 1 (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="ST"><mxGeometry x="6" y="73.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="st_2" value="LAMP 2 (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="ST"><mxGeometry x="6" y="95.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="st_3" value="LAMP 3 (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="ST"><mxGeometry x="6" y="117.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="st_n2" value="No stack-light output exists on SYSCTRL R1 yet (R27: J44, HOLD O15)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="ST"><mxGeometry x="114" y="48" width="300" height="90" as="geometry" /></mxCell><mxCell id="LC" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;PCB&lt;/font&gt;&amp;nbsp; LANECTRL ×10 (typical)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;HW_ADHERENT_LANECTRL_R1 · STM32G0B1&lt;br&gt;2 × TPS4H160 high-side (on/off) · 7 lanes per board&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="3700" y="640" width="600" height="620" as="geometry" /></mxCell><mxCell id="lc_ch" value="J8.3" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;horizontal=0;" vertex="1" parent="LC"><mxGeometry x="461.0" y="6" width="18" height="40" as="geometry" /></mxCell><mxCell id="lc_cl" value="J8.4" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;horizontal=0;" vertex="1" parent="LC"><mxGeometry x="483.0" y="6" width="18" height="40" as="geometry" /></mxCell><mxCell id="lc_p" value="J8.1 · +24V_VIN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="LC"><mxGeometry x="6" y="71.0" width="104" height="18" as="geometry" /></mxCell><mxCell id="lc_n" value="J8.2 · GND" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="LC"><mxGeometry x="6" y="93.0" width="104" height="18" as="geometry" /></mxCell><mxCell id="lc_o1" value="J1.1 · LANE_OUT1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LC"><mxGeometry x="444" y="51.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="lc_g1" value="J1.2 · GND" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LC"><mxGeometry x="444" y="73.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="lc_s1" value="J1.3 · SIG1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LC"><mxGeometry x="444" y="95.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="lc_on" value="J2…J7 .1 · LANE_OUTn" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LC"><mxGeometry x="444" y="151.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="lc_gn" value="J2…J7 .2 · GND" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LC"><mxGeometry x="444" y="173.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="lc_sn" value="J2…J7 .3 · SIGn" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LC"><mxGeometry x="444" y="195.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="lc_lp" value="LEDSn.1 · + (via 100 Ω)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LC"><mxGeometry x="444" y="261.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="lc_ln" value="LEDSn.2 · − (GND)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LC"><mxGeometry x="444" y="283.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="LC_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="LC"><mxGeometry x="120" y="110" width="300" height="52" as="geometry" /></mxCell><mxCell id="LC_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="LC"><mxGeometry x="124" y="114" width="292" height="44" as="geometry" /></mxCell><mxCell id="LC_cap" value="board render: supplied example diagram" style="text;html=1;align=center;verticalAlign=top;fontSize=8;fontColor=#8A949C;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="LC"><mxGeometry x="120" y="163" width="300" height="14" as="geometry" /></mxCell><mxCell id="lc_note" value="J8 Micro-Fit 43045-0400 (dual row): 1 +24V_VIN · 2 GND · 3 CAN_H · 4 CAN_L — the only power + bus connector.&lt;br&gt;J1–J7 Micro-Fit 43650-0300: 1 LANE_OUTn (switched +24 V) · 2 GND · 3 SIGn (feedback: +24 V through the conveyor plate switch, valid only while the lane is on).&lt;br&gt;LEDS1–7: 2-pin 2.54 mm headers for the off-board lane LEDs (pin 1 via 100 Ω, pin 2 GND).&lt;br&gt;S1 DIP = CAN node ID · P1 jumper = 120 Ω (fit on LANECTRL-01 only) · J9 SWD · J10 USB-C.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B71C1C&quot;&gt;⚠ Board R1: +24V_PR (after M1) is not joined to VM (driver / buck rail) in schematic and PCB — nothing downstream is powered until fixed. Harness tests will fail on R1 as drawn.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B71C1C&quot;&gt;⚠ Single J8: the CAN pair must enter and leave through pins 3 / 4. Micro-Fit takes one wire per crimp → splice the in / out pairs to one short tail per pin (keep the stub short), or add a second bus connector in R2.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="LC"><mxGeometry x="116" y="190" width="322" height="420" as="geometry" /></mxCell><mxCell id="CV1" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;MTR&lt;/font&gt;&amp;nbsp; CONVEYOR (lane 1 of 7)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;CB002-24V-573mm · ×70 total&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="4420" y="620" width="460" height="160" as="geometry" /></mxCell><mxCell id="cv_1" value="1 · +24 V" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CV1"><mxGeometry x="6" y="71.0" width="84" height="18" as="geometry" /></mxCell><mxCell id="cv_2" value="2 · GND" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CV1"><mxGeometry x="6" y="93.0" width="84" height="18" as="geometry" /></mxCell><mxCell id="cv_3" value="3 · SIGNAL" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CV1"><mxGeometry x="6" y="115.0" width="84" height="18" as="geometry" /></mxCell><mxCell id="CV1_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="CV1"><mxGeometry x="96" y="44" width="184" height="92" as="geometry" /></mxCell><mxCell id="CV1_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="CV1"><mxGeometry x="100" y="48" width="176" height="84" as="geometry" /></mxCell><mxCell id="cv_n" value="JST VH3.96 3-pin (VHR-3N + SVH-21T-P1.1). 0.19 A run / ≈0.5 A stall (bench). ⚠ The supplier schematic numbers the pins in reverse (3 = +) → meter-check one conveyor first." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="CV1"><mxGeometry x="284" y="36" width="172" height="122" as="geometry" /></mxCell><mxCell id="CVN" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;MTR&lt;/font&gt;&amp;nbsp; CONVEYOR lanes 2…7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;same pin-t