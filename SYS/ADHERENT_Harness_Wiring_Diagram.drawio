tColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="leg"><mxGeometry x="88" y="160" width="310" height="20" as="geometry" /></mxCell><mxCell id="hw_lg171" value="" style="endArrow=none;html=1;strokeColor=#C79100;strokeWidth=1.8;" edge="1" parent="LN"><mxGeometry relative="1" as="geometry"><mxPoint x="4110" y="1869" as="sourcePoint" /><mxPoint x="4170" y="1869" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hw_lt172" value="feedback / sensor / lane signal" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="leg"><mxGeometry x="478" y="160" width="310" height="20" as="geometry" /></mxCell><mxCell id="hw_lg173" value="" style="endArrow=none;html=1;strokeColor=#00897B;strokeWidth=2;" edge="1" parent="LN"><mxGeometry relative="1" as="geometry"><mxPoint x="4500" y="1869" as="sourcePoint" /><mxPoint x="4560" y="1869" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hw_lt174" value="motor phase A+ (A− dashed)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="leg"><mxGeometry x="868" y="160" width="310" height="20" as="geometry" /></mxCell><mxCell id="hw_lg175" value="" style="endArrow=none;html=1;strokeColor=#D81B60;strokeWidth=2;" edge="1" parent="LN"><mxGeometry relative="1" as="geometry"><mxPoint x="3720" y="1899" as="sourcePoint" /><mxPoint x="3780" y="1899" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hw_lt176" value="motor phase B+ (B− dashed)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="leg"><mxGeometry x="88" y="190" width="310" height="20" as="geometry" /></mxCell><mxCell id="hw_lg177" value="" style="endArrow=none;html=1;strokeColor=#7356A0;strokeWidth=1.8;dashed=1;dashPattern=6 3;" edge="1" parent="LN"><mxGeometry relative="1" as="geometry"><mxPoint x="4110" y="1899" as="sourcePoint" /><mxPoint x="4170" y="1899" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hw_lt178" value="NFC antenna lead" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="leg"><mxGeometry x="478" y="190" width="310" height="20" as="geometry" /></mxCell><mxCell id="hw_lg179" value="" style="endArrow=none;html=1;strokeColor=#9E9E9E;strokeWidth=1.8;dashed=1;dashPattern=2 3;" edge="1" parent="LN"><mxGeometry relative="1" as="geometry"><mxPoint x="4500" y="1899" as="sourcePoint" /><mxPoint x="4560" y="1899" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hw_lt180" value="dotted = TBC (not in design files yet)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="leg"><mxGeometry x="868" y="190" width="310" height="20" as="geometry" /></mxCell><mxCell id="leg_t" value="Pin box: &lt;b&gt;J11/J13.3 · DIR+&lt;/b&gt; = connector J11 (X) or J13 (Z), pin 3, signal DIR+ · device side: &lt;b&gt;lead colour · function&lt;/b&gt;. Pill: &lt;b&gt;④ W08&lt;/b&gt; = build step ④, cable W08. Red tag before a title = category (CONN · PCB · MTR). Lengths are R27 register estimates, not measured routes. Cable convention: 4-core 22 AWG red / black / yellow / green where electrically suitable; mains and power pairs sized per fuse / load (not yet specified)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="leg"><mxGeometry x="16" y="222" width="1150" height="72" as="geometry" /></mxCell><mxCell id="issues" value="&lt;b&gt;⚠ OPEN ISSUES FOUND WHILE DERIVING THE HARNESS&lt;/b&gt; (resolve before building the affected step)&lt;table style=&#x27;width:100%;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;width:50%&#x27;&gt;&lt;ol style=&#x27;margin:4px 0 0 0;padding-left:22px&#x27;&gt;&lt;li&gt;&lt;b&gt;SYSCTRL R1 is an early draft&lt;/b&gt;: J1, J4–J10, J15 have no nets; J11 / J13 mostly open (only J11.7, J11.9, J13.9, J13.10 connected); no CAN, sensor, stack-light or row-feed connectors yet. Pin labels on the SYSCTRL box are functional placeholders.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Row feeds&lt;/b&gt;: 10 × fused 24 V (R27 branches F1…F10, W24) needed; R1 has six fused headers (board fuses F1–F3, F5–F7, 4 A) + one eFuse header. Row fuse vs. 7 lanes × stall current is still open (R27 O03 / O04).&lt;/li&gt;&lt;li&gt;&lt;b&gt;CHUCK&lt;/b&gt; 6627T113 is an integrated driver (logic + 12–24 V); SYSCTRL J12 gives coil outputs → W16 blocked.&lt;/li&gt;&lt;li&gt;&lt;b&gt;NFC J4&lt;/b&gt; Würth 61300211821 (2.54 mm pins) does not mate with the antenna plug Molex 505565-0201 (Micro-Lock Plus 1.25 mm).&lt;/li&gt;&lt;li&gt;&lt;b&gt;LANECTRL J8&lt;/b&gt; single 4-pin plug: CAN in + out share pins 3 / 4 → splice rule or second connector. Board R1: +24V_PR / VM not joined.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Gantry sensors&lt;/b&gt; have 4 leads (PNK = L mode) → terminate PNK in the harness if the input stays 3-wire.&lt;/li&gt;&lt;li&gt;&lt;b&gt;X / Z kit&lt;/b&gt;: the listing is 48 V DC; the BOM proposes 24 V → confirm with Emtech. Brake voltage / lead colours TBC.&lt;/li&gt;&lt;/ol&gt;&lt;/td&gt;&lt;td style=&#x27;vertical-align:top;width:50%&#x27;&gt;&lt;ol style=&#x27;margin:4px 0 0 0;padding-left:26px&#x27;&gt;&lt;li value=&#x27;8&#x27;&gt;&lt;b&gt;Servo&lt;/b&gt; DS3218 needs 4.8–6.8 V → set the SYSCTRL servo buck accordingly; J15 pin map TBC.&lt;/li&gt;&lt;li value=&#x27;9&#x27;&gt;&lt;b&gt;Conveyor&lt;/b&gt; VH3.96: datasheet 1 = +24 V / 3 = SIGNAL, supplier schematic reversed → meter-check before series crimping.&lt;/li&gt;&lt;li value=&#x27;10&#x27;&gt;&lt;b&gt;J13&lt;/b&gt; nets are named _Y but drive Z → rename. &lt;b&gt;Terminations&lt;/b&gt;: CAN 120 Ω only at the MAINCTRL end (check the MYIR board) and LANECTRL-01; SYSCTRL / NFC CPC1014 off; RS485 120 Ω jumper at the last IOCTRL (NC by default).&lt;/li&gt;&lt;li value=&#x27;11&#x27;&gt;&lt;b&gt;Not selected yet&lt;/b&gt;: latches K1–K4, door sensors, jaw sensor, stack light, marker, J1 breaker / fuse, wire gauges, MAINCTRL plug / CAN / RS485 pinout (MYIR manual).&lt;/li&gt;&lt;li value=&#x27;12&#x27;&gt;&lt;b&gt;SYSCTRL branch outputs&lt;/b&gt;: about 18–19 protected outputs are needed (table on the SYSCTRL box); R1 has 7 output headers (6 fused + 1 eFuse) with undefined rails. F-numbers on the SYSCTRL box are R27 branch IDs, not R1 board fuse designators.&lt;/li&gt;&lt;li value=&#x27;13&#x27;&gt;&lt;b&gt;J1 rating&lt;/b&gt;: FN9264-6 is a 6 A part; RSP-500 AC input is up to 5.3 A (typ.) at 115 VAC → little margin at 120 V sites (the -10 variant gives headroom). Check SYSCTRL J1 (Phoenix 1757242) current rating against the 24 V load.&lt;/li&gt;&lt;/ol&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=#CFD8DC;fillColor=#FAFBFC;rounded=0;" vertex="1" parent="LN"><mxGeometry x="40" y="2090" width="3600" height="220" as="geometry" /></mxCell><mxCell id="srcs" value="&lt;b&gt;Sources used for pins and colours&lt;/b&gt;&lt;br&gt;LANECTRL R1 SchDoc / PcbDoc (2026-09-25) · NFC R1 netlist · SYSCTRL R1 netlist (2026-09-25 20:17) · ADHERENT_Electrical_Tables.xlsx · R27 harness register (git history: W-IDs, length estimates) · Mean Well RSP-500 spec · Schaffner/TE FN9264 listing · Anaheim 23MSD manual (McMaster 6627T113) · McMaster 6627T357 page + 4-lead diagram · Emtech NEMA 23 closed-loop listing (motor / encoder colours) · Miuzei DS3218 listing · Omron EE-SX47/67 datasheet · Waveshare ESP32-S3-ETH-8DI-8RO wiki + product page · MYIR MYD-YF13X product page · Molex 1462362151 sales drawing · CB002 supplier sheet + supplier schematic.&lt;br&gt;Photos: manufacturer / supplier pages; SYSCTRL and LANECTRL renders and the J2 photo come from the supplied example diagram." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=#CFD8DC;fillColor=#FAFBFC;rounded=0;" vertex="1" parent="LN"><mxGeometry x="3700" y="2090" width="1180" height="220" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="cs" name="2 · Cable schedule"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="2600" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="L0b" value="Cable schedule" parent="0" /><mxCell id="t2" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;ADHERENT · Cable schedule by build step&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Companion to page 1. Qty = instances in the machine. Lengths = R27 register estimates (not measured). Grey rows = TBC, red rows = conflict to resolve first." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#212121;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="L0b"><mxGeometry x="40" y="20" width="2900" height="60" as="geometry" /></mxCell><mxCell id="tab0" value="&lt;div style=&quot;font-size:14px;font-weight:bold;margin-bottom:4px&quot;&gt;① AC mains &amp; protective earth&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #9E9E9E;background:#ECEFF1;padding:3px 5px;text-align:left;width:70px&quot;&gt;Cable&lt;/th&gt;&lt;th style=&quot;border:1px solid #9E9E9E;background:#ECEFF1;padding:3px 5px;text-align:left;width:36px&quot;&gt;Qty&lt;/th&gt;&lt;th style=&quot;border:1px solid #9E9E9E;background:#ECEFF1;padding:3px 5px;text-align:left;width:150px&quot;&gt;Conductor / signal&lt;/th&gt;&lt;th style=&quot;border:1px solid #9E9E9E;background:#ECEFF1;padding:3px 5px;text-align:left;width:300px&quot;&gt;From (device · connector.pin)&lt;/th&gt;&lt;th style=&quot;border:1px solid #9E9E9E;background:#ECEFF1;padding:3px 5px;text-align:left;width:300px&quot;&gt;To (device · connector.pin)&lt;/th&gt;&lt;th style=&quot;border:1px solid #9E9E9E;background:#ECEFF1;padding:3px 5px;text-align:left;width:80px&quot;&gt;Length (R27 est.)&lt;/th&gt;&lt;th style=&quot;border:1px solid #9E9E9E;background:#ECEFF1;padding:3px 5px;text-align:left;width:340px&quot;&gt;Status / note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5px;vertical-align:top;background:#FFFFFF&quot;&gt;site cord&lt;/td&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5px;vertical-align:top;background:#FFFFFF&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5px;vertical-align:top;background:#FFFFFF&quot;&gt;L / N / PE&lt;/td&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5px;vertical-align:top;background:#FFFFFF&quot;&gt;site outlet&lt;/td&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5px;vertical-align:top;background:#FFFFFF&quot;&gt;J1 · IEC C14 inlet&lt;/td&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5px;vertical-align:top;background:#FFFFFF&quot;&gt;site&lt;/td&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5px;vertical-align:top;background:#FFFFFF&quot;&gt;Site-supplied IEC C13 cord set&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5px;vertical-align:top;background:#F5F5F5&quot;&gt;W01&lt;/td&gt;&lt;td style=&quot;border:1px solid #BDBDBD;padding:2px 5