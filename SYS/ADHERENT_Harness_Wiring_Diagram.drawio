xGeometry x="434" y="73.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_com" value="RO1–RO4 COM (link)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="IO1"><mxGeometry x="434" y="115.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_r1" value="RO1 · NO" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="51.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_r2" value="RO2 · NO" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="73.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_r3" value="RO3 · NO" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="95.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_r4" value="RO4 · NO" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="117.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_d1" value="DI1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="241.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_d2" value="DI2" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="263.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_d3" value="DI3" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="285.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_d4" value="DI4" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="307.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_d5" value="DI5" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="329.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="i1_dc" value="DI common (silkscreen TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="IO1"><mxGeometry x="6" y="361.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="IO1_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="IO1"><mxGeometry x="150" y="140" width="260" height="140" as="geometry" /></mxCell><mxCell id="IO1_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="IO1"><mxGeometry x="154" y="144" width="252" height="132" as="geometry" /></mxCell><mxCell id="io1_n" value="7–36 V screw terminal · isolated RS485 screw terminal, 120 Ω jumper (NC by default) · 8 relays 1NO/1NC, ≤10 A 250 VAC / 30 VDC · 8 DI 5–36 V, passive or active (NPN/PNP), bidirectional opto-isolation (Waveshare wiki / product page).&lt;br&gt;RO5–RO8 and DI6–DI8 spare (door actuators excluded, W28 qty 0).&lt;br&gt;The RS485 terminal takes the incoming and the outgoing pair (daisy-chain to IOCTRL-02)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="IO1"><mxGeometry x="136" y="296" width="300" height="172" as="geometry" /></mxCell><mxCell id="LAT" value="&lt;b&gt;K1–K4 · 12 V LATCH ×4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;main · retrieval · return · table · MPN TBC&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="40" y="760" width="590" height="150" as="geometry" /></mxCell><mxCell id="k1" value="K1 + (main)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LAT"><mxGeometry x="434" y="31.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="k2" value="K2 + (retrieval)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LAT"><mxGeometry x="434" y="53.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="k3" value="K3 + (return)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LAT"><mxGeometry x="434" y="75.0" width="150" height="18" as="geometry" /></mxCell><mxCell id="k4" value="K4 + (table)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="LAT"><mxGeometry