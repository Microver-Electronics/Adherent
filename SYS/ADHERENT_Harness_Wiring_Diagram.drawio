ry" /></mxCell><mxCell id="sy_cl" value="CAN_L (conn. TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;horizontal=0;" vertex="1" parent="SYS"><mxGeometry x="513.0" y="6" width="18" height="96" as="geometry" /></mxCell><mxCell id="sy_nfc_p" value="+24 V → NFC (branch TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="31.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_nfc_n" value="0 V → NFC" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="53.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d1" value="J11/J13.1 · PUL+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="161.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d2" value="J11/J13.2 · PUL−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="183.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d3" value="J11/J13.3 · DIR+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="205.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d4" value="J11/J13.4 · DIR−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="227.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d5" value="J11/J13.5 · ENA+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="249.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d6" value="J11/J13.6 · ENA−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="271.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d7" value="J11/J13.7 · ALM_IN (4k7 pull-up)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="293.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d8" value="J11/J13.8 · GND" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="315.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_dp" value="DRIVE +24 V · F15 (X) / F16 (Z)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="337.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_dn" value="DRIVE 0 V" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="359.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_d9" value="J11/J13.9 · +24V_MOT (brake +)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;h