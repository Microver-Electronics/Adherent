<mxfile host="Electron" agent="Blackocean Technologies" pages="3"><diagram id="hw" name="1 · Harness wiring"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4920" pageHeight="2330" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="L0" value="Devices · connectors · photos" parent="0" /><mxCell id="L1" value="Step 1 · AC mains &amp; protective earth" parent="0" /><mxCell id="L2" value="Step 2 · 24 V main feed" parent="0" /><mxCell id="L3" value="Step 3 · Cabinet DC branches" parent="0" /><mxCell id="L4" value="Step 4 · CAN bus" parent="0" /><mxCell id="L5" value="Step 5 · Ethernet &amp; RS485" parent="0" /><mxCell id="L6" value="Step 6 · Gantry X / Z drives" parent="0" /><mxCell id="L7" value="Step 7 · Labeling motors &amp; servo" parent="0" /><mxCell id="L8" value="Step 8 · Sensors" parent="0" /><mxCell id="L9" value="Step 9 · Doors &amp; latches" parent="0" /><mxCell id="L10" value="Step 10 · Lane rows" parent="0" /><mxCell id="L11" value="Step 11 · Status light &amp; marker (TBC)" parent="0" /><mxCell id="LN" value="Notes · legend · open issues" parent="0" /><mxCell id="title" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;ADHERENT · Harness Wiring Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Pin-level companion to ADHERENT_System_Wiring_Diagram · Blackocean Technologies · 2026-09-26 · &lt;b&gt;working document for harness derivation — not a release drawing&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="LN"><mxGeometry x="40" y="16" width="1220" height="70" as="geometry" /></mxCell><mxCell id="howto" value="&lt;b&gt;How to use&lt;/b&gt; · Layers = build steps ①…⑪ (draw.io: View ▸ Layers, Ctrl+Shift+L) — switch on one step at a time and cut / crimp that step only. · Pin box = &lt;b&gt;connector.pin · signal&lt;/b&gt; (board side) or &lt;b&gt;lead colour · function&lt;/b&gt; (device side). · Boxes marked ×n are typical: one drawing stands for n identical instances; page 2 lists every instance with cable ID and length. · Dotted wire = TBC (not yet defined in the design files). · &lt;font color=&quot;#D32F2F&quot;&gt;&lt;b&gt;⚠ red box = interface conflict found in the documents — resolve before crimping.&lt;/b&gt;&lt;/font&gt; · Cable IDs (W01…W39) follow the project harness register." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=#CFD8DC;fillColor=#FAFBFC;rounded=0;" vertex="1" parent="LN"><mxGeometry x="1300" y="14" width="2330" height="78" as="geometry" /></mxCell><mxCell id="SITE" value="&lt;b&gt;SITE LAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;customer network&lt;br&gt;site-supplied&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="40" y="250" width="220" height="150" as="geometry" /></mxCell><mxCell id="site_rj" value="RJ45 · site patch" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SITE"><mxGeometry x="104" y="61.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="J2" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;CONN&lt;/font&gt;&amp;nbsp; J2 · RJ45 PANEL ADAPTER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;McMaster-Carr 1422N13 · rear panel&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#F