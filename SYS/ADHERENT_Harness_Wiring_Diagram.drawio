th="200" height="18" as="geometry" /></mxCell><mxCell id="sy_g_n" value="SENS 0 V ×6" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1097.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_g_s" value="SENS IN · X1–X3 / Z1–Z3" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1119.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_js_p" value="JAW-SENS +V (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1239.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_js_n" value="JAW-SENS 0 V (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1261.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_js_s" value="JAW-SENS IN (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1283.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_st_p" value="STACK +12 V (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1381.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_st_1" value="STACK OUT 1 (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1403.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_st_2" value="STACK OUT 2 (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1425.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_st_3" value="STACK OUT 3 (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1447.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_row_p" value="ROW FEED +24 V ×10 · branch F1…F10" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1521.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="sy_row_n" value="ROW FEED 0 V (×10)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="SYS"><mxGeometry x="694" y="1543.0" width="200" height="18" as="geometry" /></mxCell><mxCell id="SYS_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="SYS"><mxGeometry x="250" y="150" width="400" height="380" as="geometry" /></mxCell><mxCell id="SYS_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="SYS"><mxGeometry x="254" y="154" width="392" height="372" as="geometry" /></mxCell><mxCell id="SYS_cap" value="board render: supplied example diagram (R1 layout in progress)" style="text;html=1;align=center;verticalAlign=top;fontSize=8;fontColor=#8A949C;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;connectable=0;" vertex="1" parent="SYS"><mxGeometry x="250" y="531" width="400" height="14" as="geometry" /></mxCell><mxCell id="sys_n" value="&lt;b&gt;What the R1 schematic already defines&lt;/b&gt; (netlist export 2026-09-25 20:17):&lt;br&gt;• &lt;b&gt;Input&lt;/b&gt; J1 Phoenix 1757242 (2-pos 5.08 mm); same sheet: LM74700 ideal-diode controller + 2 × CSD18540 + SMDJ33A TVS. Not yet on nets.&lt;br&gt;• &lt;b&gt;12 V&lt;/b&gt; LM5146 buck, 24 V in → 12 V / 12 A (sheet title). Logic rails LMR33630 + TLV75733.&lt;br&gt;• &lt;b&gt;Fused outputs&lt;/b&gt; F1–F7 4 A/72 V; by placement F1→J4, F2→J5, F3→J6, F5→J8 (5-pin), F6→J9 (5-pin), F7→J10, F4 without connector; J7 via TPS16637 eFuse. Nets not yet connected → the functional outputs on this box (F13, F15–F18, F1…F10, NFC, stack, marker) still have to be assigned to real connectors.&lt;br&gt;• &lt;b&gt;X / Z drive&lt;/b&gt; J11 / J13 Micro-Fit 43045-1000 (10-pin): AM26C31 differential PUL / DIR / ENA, ALM input (4k7 pull-up), pin 9 = +24V_MOT, pin 10 = BRK− (DMN6140 low side). In the netlist only J11.7, J11.9, J13.9 and J13.10 reach circuitry (J11.8 is linked only to J13.8); the rest is open. J13 nets are named _Y although J13 drives Z → rename.&lt;br&gt;• &lt;b&gt;Chuck&lt;/b&gt; J12 43045-0400 ← TMC5160 + BSC072N08 bridge (coil outputs).&lt;br&gt;• &lt;b&gt;Jaws&lt;/b&gt; J14 43045-0400 ← TMC2240 (coil outputs).&lt;br&gt;• &lt;b&gt;Servo&lt;/b&gt; J15 Molex 43650-0300 on sheet DRIVER4 with TPS54560 buck, INA181 current sense and 74AHCT1G125 buffer (servo stage; pin map TBC).&lt;br&gt;• &lt;b&gt;CAN&lt;/b&gt; SN65HVD232 + switchable 112 Ω termination (2 × 56 Ω in series through the CPC1014 contact, CAN_TERM) — no bus connector placed yet; keep it OFF (SYSCTRL is not a bus end).&lt;br&gt;• &lt;b&gt;Not yet in R1&lt;/b&gt;: sensor inputs (R27: J21–J27 Micro-Fit 3-pin), stack-light outputs, ten row feeds.&lt;br&gt;• Service: J2 UART (SWR201), J3 SWD (FTSH-105).&lt;br&gt;F13 / F15–F18 / F1…F10 on the functional pins are R27 branch IDs, not R1 board fuses." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=#CFD8DC;fillColor=#FAFBFC;rounded=0;" vertex="1" parent="SYS"><mxGeometry x="222" y="556" width="456" height="330" as="geometry" /></mxCell><mxCell id="sys_outs" value="&lt;b&gt;Branch outputs the harness needs from SYSCTRL&lt;/b&gt; (functional, from the cable list)&lt;table style=&#x27;border-collapse:collapse;width:100%;margin-top:4px;font-size:9px&#x27;&gt;&lt;tr style=&#x27;background:#ECEFF1&#x27;&gt;&lt;th style=&#x27;border:1px solid #CFD8DC;text-align:left;padding:1px 4px&#x27;&gt;Output&lt;/th&gt;&lt;th style=&#x27;border:1px solid #CFD8DC;text-align:left;padding:1px 4px&#x27;&gt;Rail&lt;/th&gt;&lt;th style=&#x27;border:1px solid #CFD8DC&#x27;&gt;Qty&lt;/th&gt;&lt;th style=&#x27;border:1px solid #CFD8DC;text-align:left;padding:1px 4px&#x27;&gt;Cable&lt;/th&gt;&lt;th style=&#x27;border:1px solid #CFD8DC;text-align:left;padding:1px 4px&#x27;&gt;R1 status&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;Row feeds LANECTRL-01…10&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;24 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;10&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;W24&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;6 fused headers + J7 eFuse exist; nets open&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;X / Z driver supply&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;24 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;2&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;W29 / W30&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;not assigned&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;IOCTRL-01 / -02 supply&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;24 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;1–2&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;W34&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;not assigned (R27: 1 feed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;NFC reader supply&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;24 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;1&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;TBC&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;not assigned&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;Marker supply&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;TBC&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;1&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;W39&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;marker not selected&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;MAINCTRL&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;12 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;1&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;W05&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;not assigned&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;Relay COM → latches&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;12 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;1&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;W35&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;not assigned&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;Stack light&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;12 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;1&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;W36&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;no output circuit in R1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;Servo (own buck)&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;4.8–6.8 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;1&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;W13&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;J15 + TPS54560 exist&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;X / Z brakes&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;24 V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px;text-align:center&#x27;&gt;2&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;in W11 / W12&lt;/td&gt;&lt;td style=&#x27;border:1px solid #CFD8DC;padding:1px 4px&#x27;&gt;J11 / J13 pin 9 +24V_MOT&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;font color=&quot;#B71C1C&quot;&gt;&lt;b&gt;⚠ About 18–19 protected branch outputs are needed; R1 has 7 output headers (J4–J10: six behind board fuses F1–F3 / F5–F7, one behind the J7 eFuse; F4 has no header) and their rails are not yet defined.&lt;/b&gt;&lt;/font&gt; Options: more fused outputs on SYSCTRL, or a separate fused distribution for the ten row feeds. F-numbers in this table and on the pins are R27 branch IDs, not R1 board fuses." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#212121;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=#CFD8DC;fillColor=#FAFBFC;rounded=0;" vertex="1" parent="SYS"><mxGeometry x="222" y="900" width="456" height="300" as="geometry" /></mxCell><mxCell id="NFC" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;PCB&lt;/font&gt;&amp;nbsp; NFC · HW_ADHERENT_NFC_R1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;custom reader PCB&lt;br&gt;STM32F103C8 + ST25R200&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="2700" y="190" width="430" height="210" as="geometry" /></mxCell><mxCell id="n_ch" value="J1.3 CAN1_P" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;horizontal=0;" vertex="1" parent="NFC"><mxGeometry x="291.0" y="6" width="18" height="70" as="geometry" /></mxCell><mxCell id="n_cl" value="J1.4 CAN1_N" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;horizontal=0;" vertex="1" parent="NFC"><mxGeometry x="313.0" y="6" width="18" height="70" as="geometry" /></mxCell><mxCell id="n_p" value="J1.1 · +24V_VIN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="NFC"><mxGeometry x="6" y="141.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="n_n" value="J1.2 · GND" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="NFC"><mxGeometry x="6" y="163.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="n_a1" value="J4.1 · ANT" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="NFC"><mxGeometry x="344" y="101.0" width="80" height="18" as="geometry" /></mxCell><mxCell id="n_a2" value="J4.2 · ANT" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="NFC"><mxGeometry x="344" y="123.0" width="80" height="18" as="geometry" /></mxCell><mxCell id="NFC_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="NFC"><mxGeometry x="116" y="84" width="170" height="118" as="geometry" /></mxCell><mxCell id="NFC_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="NFC"><mxGeometry x="120" y="88" width="162" height="110" as="geometry" /></mxCell><mxCell id="nfc_n" value="Switchable 112 Ω (CPC1014): OFF unless NFC is a bus end." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="NFC"><mxGeometry x="292" y="150" width="134" height="58" as="geometry" /></mxCell><mxCell id="ANT" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;CONN&lt;/font&gt;&amp;nbsp; ANT-NFC · Molex 1462362151&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;13.56 MHz · 15 × 15 mm · adhesive&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="3240" y="190" width="360" height="210" as="geometry" /></mxCell><mxCell id="a_1" value="RED lead" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="ANT"><mxGeometry x="6" y="101.0" width="74" height="18" as="geometry" /></mxCell><mxCell id="a_2" value="BLACK lead" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="ANT"><mxGeometry x="6" y="123.0" width="74" height="18" as="geometry" /></mxCell><mxCell id="ANT_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="ANT"><mxGeometry x="96" y="42" width="60" height="160" as="geometry" /></mxCell><mxCell id="ANT_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="ANT"><mxGeometry x="100" y="46" width="52" height="152" as="geometry" /></mxCell><mxCell id="ant_n" value="Lead 102 mm, twisted pair RED / BLACK 28 AWG. Plug Molex 505565-0201 (Micro-Lock Plus 1.25 mm) + 505431-1000 terminals (Molex drawing)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="ANT"><mxGeometry x="160" y="44" width="196" height="160" as="geometry" /></mxCell><mxCell id="DRV" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;MTR&lt;/font&gt;&amp;nbsp; X / Z DRIVER ×2 (typical)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;Emtech closed-loop driver · supplied with the motor kit&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="2650" y="410" width="420" height="340" as="geometry" /></mxCell><mxCell id="dv_1" value="PUL+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="51.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_2" value="PUL−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="73.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_3" value="DIR+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="95.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_4" value="DIR−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="117.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_5" value="ENA+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="139.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_6" value="ENA−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="161.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_7" value="ALM+ (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="183.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_8" value="ALM− (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="205.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_p" value="+V DC (24 V proposed)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="227.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_n" value="GND" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="DRV"><mxGeometry x="6" y="249.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="dv_ap" value="A+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="DRV"><mxGeometry x="314" y="51.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="dv_am" value="A−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="DRV"><mxGeometry x="314" y="73.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="dv_bp" value="B+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="DRV"><mxGeometry x="314" y="95.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="dv_bm" value="B−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="DRV"><mxGeometry x="314" y="117.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="dv_enc" value="ENCODER · DB15" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=right;spacingRight=4;" vertex="1" parent="DRV"><mxGeometry x="314" y="161.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="DRV_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="DRV"><mxGeometry x="124" y="58" width="170" height="136" as="geometry" /></mxCell><mxCell id="DRV_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="DRV"><mxGeometry x="128" y="62" width="162" height="128" as="geometry" /></mxCell><mxCell id="drv_n" value="X = SYSCTRL J11, Z = J13. Terminal names per driver label (the listing gives none) — check before crimping. Listing: 48 V DC kit; BOM: 24 V proposed → confirm." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="DRV"><mxGeometry x="118" y="206" width="196" height="128" as="geometry" /></mxCell><mxCell id="MOT" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;MTR&lt;/font&gt;&amp;nbsp; X / Z MOTOR ×2 (typical)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;Emtech 57BYG250-76 · closed loop · brake · encoder&lt;/font&gt;" style="rounded=1;arcS