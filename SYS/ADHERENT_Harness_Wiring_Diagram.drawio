etry x="6" y="271.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="mt_bk_n" value="BRAKE − (colour TBC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="MOT"><mxGeometry x="6" y="293.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="MOT_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="MOT"><mxGeometry x="150" y="56" width="240" height="100" as="geometry" /></mxCell><mxCell id="MOT_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="MOT"><mxGeometry x="154" y="60" width="232" height="92" as="geometry" /></mxCell><mxCell id="mot_n" value="Emtech listing: motor lead A+ WHT · A− GRN · B+ BLU · B− BLK (2.0 m). Encoder: 0.3 m lead on the motor + 1.7 m extension, DB15: WHT 0 V · RED +5 V · YEL EB+ · GRN EB− · BLU EA− · BLK EA+. Brake: 2 leads, voltage and colours TBC (fed from SYSCTRL J11/J13 pins 9–10, not from the driver)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="MOT"><mxGeometry x="150" y="160" width="244" height="176" as="geometry" /></mxCell><mxCell id="SRV" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;MTR&lt;/font&gt;&amp;nbsp; SERVO · Miuzei DS3218&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;basket tilt · 20 kg · DC 4.8–6.8 V&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="2650" y="785" width="420" height="134" as="geometry" /></mxCell><mxCell id="sv_p" value="RED · +V 4.8–6.8 V" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="SRV"><mxGeometry x="6" y="51.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="sv_n" value="BLACK · GND" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="SRV"><mxGeometry x="6" y="73.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="sv_s" value="WHITE · PWM" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="SRV"><mxGeometry x="6" y="95.0" width="120" height="18" as="geometry" /></mxCell><mxCell id="SRV_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="SRV"><mxGeometry x="134" y="44" width="110" height="84" as="geometry" /></mxCell><mxCell id="SRV_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="SRV"><mxGeometry x="138" y="48" width="102" height="76" as="geometry" /></mxCell><mxCell id="srv_n" value="Lead colours as pictured on the supplier listing. Set the SYSCTRL servo buck (TPS54560) inside 4.8–6.8 V." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="SRV"><mxGeometry x="250" y="44" width="166" height="84" as="geometry" /></mxCell><mxCell id="CHK" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;MTR&lt;/font&gt;&amp;nbsp; CHUCK · McMaster 6627T113&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;= Anaheim 23MSD006S-00-00-00 · NEMA 23 integrated step driver · sinking inputs&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="2650" y="930" width="950" height="222" as="geometry" /></mxCell><mxCell id="ck1" value="1 · DIR · BRN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CHK"><mxGeometry x="6" y="51.0" width="130" height="18" as="geometry" /></mxCell><mxCell id="ck2" value="2 · CLK · RED" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CHK"><mxGeometry x="6" y="73.0" width="130" height="18" as="geometry" /></mxCell><mxCell id="ck3" value="3 · ON/OFF · ORN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CHK"><mxGeometry x="6" y="95.0" width="130" height="18" as="geometry" /></mxCell><mxCell id="ck4" value="4 · MS2 · YEL" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CHK"><mxGeometry x="6" y="117.0" width="130" height="18" as="geometry" /></mxCell><mxCell id="ck5" value="5 · MS1 · GRN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CHK"><mxGeometry x="6" y="139.0" width="130" height="18" as="geometry" /></mxCell><mxCell id="ck6" value="6 · +12–24 VDC · BLU" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CHK"><mxGeometry x="6" y="161.0" width="130" height="18" as="geometry" /></mxCell><mxCell id="ck7" value="7 · 0 VDC · VIO" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="CHK"><mxGeometry x="6" y="183.0" width="130" height="18" as="geometry" /></mxCell><mxCell id="CHK_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="CHK"><mxGeometry x="144" y="52" width="150" height="150" as="geometry" /></mxCell><mxCell id="CHK_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="CHK"><mxGeometry x="148" y="56" width="142" height="142" as="geometry" /></mxCell><mxCell id="chk_n" value="7-pin input: AMP 640440-7 (CBL-AA4031, 12 in leads). Open input = inactive (pulled up to +5 V inside); active = pulled to 0 V. MS1/MS2 select 2 / 8 / 64 / 256 microsteps. Source: Anaheim 23MSD manual (McMaster 6627T113)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="CHK"><mxGeometry x="300" y="48" width="250" height="164" as="geometry" /></mxCell><mxCell id="chk_w" value="⚠ &lt;b&gt;W16 blocked.&lt;/b&gt; SYSCTRL J12 carries TMC5160 coil outputs (BMA1/BMA2/BMB1/BMB2). 6627T113 has its own driver and needs CLK/DIR/ON-OFF/MS1/MS2 logic + 12–24 V supply — a 4-wire phase cable cannot work.&lt;br&gt;Decide one: (a) change CHUCK to a plain bipolar NEMA 23 motor on J12, or (b) keep 6627T113 and give SYSCTRL open-drain CLK/DIR/ON-OFF outputs + a fused 24 V pair on a 7-way connector." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontFamily=Helvetica;spacing=5;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=1.5;fontColor=#B71C1C;connectable=0;" vertex="1" parent="CHK"><mxGeometry x="560" y="48" width="384" height="118" as="geometry" /></mxCell><mxCell id="JAW" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;MTR&lt;/font&gt;&amp;nbsp; JAWS · McMaster 6627T357&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;NEMA 11 bipolar · 0.67 A/phase · 5.6 Ω · 3.08 mH&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="2650" y="1160" width="420" height="156" as="geometry" /></mxCell><mxCell id="jw1" value="RED · A+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="JAW"><mxGeometry x="6" y="51.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="jw2" value="BLUE · A−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="JAW"><mxGeometry x="6" y="73.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="jw3" value="GREEN · B+" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="JAW"><mxGeometry x="6" y="95.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="jw4" value="BLACK · B−" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="JAW"><mxGeometry x="6" y="117.0" width="100" height="18" as="geometry" /></mxCell><mxCell id="JAW_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="JAW"><mxGeometry x="114" y="48" width="110" height="84" as="geometry" /></mxCell><mxCell id="JAW_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="JAW"><mxGeometry x="118" y="52" width="102" height="76" as="geometry" /></mxCell><mxCell id="jaw_n" value="4 leads 26 AWG, 24 in. Colour code per the McMaster 4-lead diagram (A = red, Ā = blue, B = green, B̄ = black). Set TMC2240 run current ≤ 0.67 A." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="JAW"><mxGeometry x="228" y="44" width="188" height="104" as="geometry" /></mxCell><mxCell id="GS" value="&lt;b&gt;X-SENS ×3 / Z-SENS ×3 (typical ×6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;Omron EE-SX672-WR (X) · EE-SX674-WR (Z)&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="2650" y="1324" width="420" height="156" as="geometry" /></mxCell><mxCell id="gs_p" value="BRN · +V 5–24 V" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="GS"><mxGeometry x="6" y="51.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="gs_n" value="BLU · 0 V" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="GS"><mxGeometry x="6" y="73.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="gs_s" value="BLK · OUT (NPN OC)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="GS"><mxGeometry x="6" y="95.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="gs_l" value="PNK · L (mode)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#616161;fontSize=9;html=1;whiteSpace=wrap;spacing=1;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="GS"><mxGeometry x="6" y="117.0" width="110" height="18" as="geometry" /></mxCell><mxCell id="GS_ph" value="" style="rounded=0;fillColor=#F7F7F7;strokeColor=#E0E0E0;connectable=0;html=1;" vertex="1" parent="GS"><mxGeometry x="122" y="48" width="90" height="76" as="geometry" /></mxCell><mxCell id="GS_img" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;connectable=0;image=data:image/jpeg,;" vertex="1" parent="GS"><mxGeometry x="126" y="52" width="82" height="68" as="geometry" /></mxCell><mxCell id="gs_n2" value="1 m pre-wired leads. OUT 100 mA max. PNK (L) open = dark-ON; PNK to BRN = light-ON (Omron datasheet). The SYSCTRL input is 3-wire → terminate PNK in the harness for the chosen mode." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#5F6B76;fontFamily=Helvetica;spacing=3;connectable=0;strokeColor=none;fillColor=none;" vertex="1" parent="GS"><mxGeometry x="216" y="44" width="200" height="108" as="geometry" /></mxCell><mxCell id="JS" value="&lt;b&gt;JAW-SENS · jaw home sensor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;part TBC · W18&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#9E9E9E;fillColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fontColor=#212121;fontFamily=Helvetica;" vertex="1" parent="L0"><mxGeometry x="2650" y="1488" width="420" height="134" as="geometry" /></mxCell><mxCell id="js_p" value="+V (TBC)" style="rounded=0;fillColor=#FFFFFF;strokeCol