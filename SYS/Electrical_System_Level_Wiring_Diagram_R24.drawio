<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" agent="Blackocean Technologies"><diagram id="esl-wiring" name="Electrical System Level Wiring Diagram"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3240" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Electrical System Level Wiring Diagram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#7C858E&quot;&gt;Adherent360 APDU / AVM · Blackocean Technologies · based on AVM-FRAME-MAINASSEMBLY_V4 · 10 rows × 7 lanes = 70 conveyors · &lt;b&gt;R24&lt;/b&gt; · 2026-09-14&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="60" as="geometry" /></mxCell><mxCell id="g_net" value="NETWORK / USER ACCESS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F9;strokeColor=#1D5FA8;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1D5FA8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="430" as="geometry" /></mxCell><mxCell id="rj45" value="&lt;b&gt;RJ45 bulkhead&lt;/b&gt;&lt;br&gt;rear panel · hard-wired LAN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="220" height="80" as="geometry" /></mxCell><mxCell id="wifi" value="&lt;b&gt;Wi-Fi / BT antenna&lt;/b&gt;&lt;br&gt;bulkhead RP-SMA&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;USB Wi-Fi / BT module on MAINCTRL, optional&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="310" y="160" width="220" height="80" as="geometry" /></mxCell><mxCell id="lan" value="&lt;b&gt;Pharmacy LAN / router&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F9;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="460" height="60" as="geometry" /></mxCell><mxCell id="ipad" value="&lt;b&gt;iPad&lt;/b&gt; (not integrated)&lt;br&gt;Adherent app / web browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="220" height="90" as="geometry" /></mxCell><mxCell id="cloud" value="&lt;b&gt;Adherent servers&lt;/b&gt;&lt;br&gt;internet · vend API" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D5FA8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="380" width="220" height="130" as="geometry" /></mxCell><mxCell id="g_power" value="AC INPUT &amp;amp; POWER SUPPLIES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F0EE;strokeColor=#BE3A2B;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#BE3A2B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="520" height="500" as="geometry" /></mxCell><mxCell id="acin" value="&lt;b&gt;AC inlet · EMI filter · main breaker&lt;/b&gt;&lt;br&gt;120 / 230 VAC · IEC C14 + PE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="460" height="70" as="geometry" /></mxCell><mxCell id="psu24" value="&lt;b&gt;PSU1 · 24 V · 500 W&lt;/b&gt;&lt;br&gt;Mean Well RSP-500-24&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;conveyors · chuck steppers&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="770" width="140" height="120" as="geometry" /></mxCell><mxCell id="psu12" value="&lt;b&gt;PSU2 · 12 V · 150 W&lt;/b&gt;&lt;br&gt;Mean Well LRS-150-12&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;all board logic · latches · DOORIO&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="230" y="770" width="140" height="120" as="geometry" /></mxCell><mxCell id="psu48" value="&lt;b&gt;PSU3 · 48 V · 500 W&lt;/b&gt;&lt;br&gt;S-500-48 (mech BOM)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;X + Z closed-loop drives · 10.4 A · fan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="390" y="770" width="140" height="120" as="geometry" /></mxCell><mxCell id="pwr_note" value="Each board regulates its own 5 V / 3.3 V from 12 V. No cabinet-level DC-DC." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="915" width="460" height="40" as="geometry" /></mxCell><mxCell id="g_cab" value="CONTROL CABINET · base compartment (behind AVM-BASE-COVER)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="560" height="900" as="geometry" /></mxCell><mxCell id="sbc" value="&lt;b&gt;MAINCTRL · MYIR MYD-YF13X (COTS)&lt;/b&gt; · FW_ADHERENT_MAINCTRL_R1&lt;br&gt;ST STM32MP135 · Cortex-A7 1 GHz · 512 MB DDR3L · 4 GB eMMC · Linux 5.15 BSP&lt;br&gt;supervisory app: web UI, REST vend API, job log, CAN master, RS485 master&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;12 V / 2 A in · 2 × GbE · 2 × USB 2.0 host + USB-C OTG · 1 × CAN FD (120 Ω term.) · RS485 · RS232 · Wi-Fi / BT only via USB module · −40…85 °C · 137 × 105 mm&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="500" height="150" as="geometry" /></mxCell><mxCell id="motion" value="&lt;b&gt;SYSCTRL · real-time machine board (STM32)&lt;/b&gt; · HW_ADHERENT_SYSCTRL_R1 · FW_ADHERENT_SYSCTRL_R1&lt;br&gt;&lt;b&gt;Gantry:&lt;/b&gt; X + Z closed-loop drives — STEP / DIR / ENA out, ALARM in, 24 V brake out (drivers integrated in the motors) · tilt servo PWM + 6.8 V / 3 A buck · 6 × opto in&lt;br&gt;&lt;b&gt;Labeling mechanism:&lt;/b&gt; chuck rotate (TMC5160) + chuck jaw (TMC2209) stepper drivers · jaw home sensor in&lt;br&gt;&lt;b&gt;Doors:&lt;/b&gt; handled by the DOORIO module (RS485 from MAINCTRL) · SYSCTRL keeps stack light + spare outputs&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;CAN node · stack light (12 V) · temp / humidity · 24 V motor rail (F11) + 12 V logic rail (F12) in · on-board 3.3 V · passes 12 V (F14) onto the lane-bus cable&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="370" width="500" height="250" as="geometry" /></mxCell><mxCell id="dist" value="&lt;b&gt;24 V + 12 V + 48 V distribution · DIN fuse block&lt;/b&gt;&lt;br&gt;24 V: F1–F10 lane rows (5 A ea) · F11 SYSCTRL chuck motors (6 A)&lt;br&gt;12 V: F12 SYSCTRL (6 A) · F13 MAINCTRL (3 A) · F14 lane-bus rail (3 A) · F17 DOORIO + latches (3 A)&lt;br&gt;48 V: F15 X drive (5 A) · F16 Z drive (5 A)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="690" width="500" height="120" as="geometry" /></mxCell><mxCell id="cab_note" value="Only 2 cables leave the cabinet per lane row: one fused 24 V motor feeder and the CAN + 12 V bus cable (5-way shielded, daisy-chained). All 70 conveyor cables stay inside their rows." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="790" y="850" width="500" height="60" as="geometry" /></mxCell><mxCell id="g_gantry" value="GANTRY (motor group 1) · JB-GANTRY · igus E2i.17 chains X 762 mm / Z 1616 mm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1640" y="110" width="640" height="320" as="geometry" /></mxCell><mxCell id="xstep" value="&lt;b&gt;X closed-loop stepper + integrated drive&lt;/b&gt;&lt;br&gt;Emtech 57BYG250-76 · 2 N·m · 4 A · brake · 3:1 gearbox&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;24–48 V in · STEP/DIR/ENA in · ALARM out · brake 24 V (TBC)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="160" width="290" height="100" as="geometry" /></mxCell><mxCell id="zstep" value="&lt;b&gt;Z closed-loop stepper + integrated drive&lt;/b&gt;&lt;br&gt;Emtech 57BYG250-76 · 2 N·m · 4 A · brake holds carriage&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;24–48 V in · STEP/DIR/ENA in · ALARM out · brake 24 V (TBC)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1990" y="160" width="290" height="100" as="geometry" /></mxCell><mxCell id="servo" value="&lt;b&gt;Basket tilt servo · Miuzei DS3218 270°&lt;/b&gt;&lt;br&gt;4.8–6.8 V · stall 2.2 A @ 6.8 V · idle 5 mA&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;PWM 500–2500 µs, 50–330 Hz · 300 mm lead · on Z carriage&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="300" width="290" height="100" as="geometry" /></mxCell><mxCell id="optos" value="&lt;b&gt;6 × Omron EE-SX67x-WR, pre-wired 1 m&lt;/b&gt;&lt;br&gt;X: EE-SX672-WR ×3 · Z: EE-SX674-WR ×3&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;5–24 V · 12 mA · NPN 100 mA · brown Vcc, blue 0 V, black OUT, pink L · via JB-GANTRY&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1990" y="300" width="290" height="100" as="geometry" /></mxCell><mxCell id="g_station" value="LABELING MECHANISM (motor group 2) · laser platform assembly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1640" y="490" width="640" height="300" as="geometry" /></mxCell><mxCell id="chuck" value="&lt;b&gt;Chuck rotate stepper&lt;/b&gt;&lt;br&gt;NEMA23 + gearbox (6627T113) · 4-wire" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="540" width="290" height="90" as="geometry" /></mxCell><mxCell id="jaws" value="&lt;b&gt;Chuck jaw stepper&lt;/b&gt;&lt;br&gt;NEMA11 (6627T357) · T5 belt · 4-wire&lt;br&gt;+ jaw home sensor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1990" y="540" width="290" height="90" as="geometry" /></mxCell><mxCell id="camq" value="&lt;b&gt;Camera / OCR&lt;/b&gt; · not in scope&lt;br&gt;open question to the customer · MAINCTRL keeps a free USB 2.0 + GbE port" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6510;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="670" width="290" height="90" as="geometry" /></mxCell><mxCell id="printer" value="&lt;b&gt;Label marker&lt;/b&gt; (laser marker or thermal printer — TBC)&lt;br&gt;USB / Ethernet · own PSU from AC bus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6510;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1990" y="670" width="290" height="90" as="geometry" /></mxCell><mxCell id="g_doors" value="DOORS &amp;amp; LATCHES · DOORIO module · JB-DOORS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1640" y="850" width="640" height="330" as="geometry" /></mxCell><mxCell id="doorio" value="&lt;b&gt;DOORIO · Waveshare ESP32-S3-ETH-8DI-8RO (COTS)&lt;/b&gt; · FW_ADHERENT_DOORIO_R1 · Modbus RTU slave&lt;br&gt;8 × relay 10 A (1NO 1NC) · 8 × isolated DI · isolated RS485 (120 Ω jumper) · 7–36 V in · DIN box near the doors&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;RO1–4 latches K1–K4 · RO5–8 future actuators · DI1–5 door sensors · Wi-Fi / BLE / Ethernet unused&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=2;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="900" width="610" height="90" as="geometry" /></mxCell><mxCell id="latches" value="&lt;b&gt;4 × EM latch · 12 V&lt;/b&gt; · K1 main · K2 retrieval · K3 return · K4 table&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;flyback diode per coil · ← DOORIO RO1–RO4 · W20, W21&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="1030" width="290" height="70" as="geometry" /></mxCell><mxCell id="doorsens" value="&lt;b&gt;5 × door sensor&lt;/b&gt; · reed / microswitch&lt;br&gt;main · retrieval · return · table · front access&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;→ DOORIO DI1–DI5 · W23 → JB-DOORS → W22&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1990" y="1030" width="290" height="70" as="geometry" /></mxCell><mxCell id="dooract" value="&lt;b&gt;Door 12 V actuator set&lt;/b&gt; · to be defined by the customer · placeholder: DOORIO RO5–RO8 as two reversing relay pairs (W28)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6510;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1670" y="1130" width="610" height="36" as="geometry" /></mxCell><mxCell id="g_lanes" value="LANE ROWS · 10 rows × 7 lanes · HW_ADHERENT_LANECTRL_R1 ×10 (FW_ADHERENT_LANECTRL_R1) · buttons + LEDs on board · 24 V bus bar = F1–F10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#171A1F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#171A1F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2500" y="110" width="700" height="1150" as="geometry" /></mxCell><mxCell id="busbar" value="" style="rounded=0;html=1;fillColor=#BE3A2B;strokeColor=#BE3A2B;" vertex="1" parent="1"><mxGeometry x="2515" y="160" width="6" height="1000" as="geometry" /></mxCell><mxCell id="lc1" value="&lt;b&gt;LANECTRL-01&lt;/b&gt; · node 1 · 120 Ω term.&lt;br&gt;7 × H-bridge + TVS · 7 × feedback · 7 × button + LED on board&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;24 V in (F1) · 12 V via bus cable · front of row&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2570" y="160" width="270" height="80" as="geometry" /></mxCell><mxCell id="lanes1" value="&lt;b&gt;7 × lane&lt;/b&gt; · CB002-24V-573mm&lt;br&gt;24 V · ≤0.2 A idle · 5.8 cm/s · ≤6 kg&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;button + LED per lane, on LANECTRL-01&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2930" y="160" width="240" height="80" as="geometry" /></mxCell><mxCell id="lc2" value="&lt;b&gt;LANECTRL-02&lt;/b&gt; · CAN node 2&lt;br&gt;7 × H-bridge + TVS · 7 × feedback · 7 × button + LED on board&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;24 V in (F2) · 12 V via bus cable · front of row&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=11;spaci