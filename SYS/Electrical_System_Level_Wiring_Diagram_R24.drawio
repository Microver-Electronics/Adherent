2;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2570" y="660" width="270" height="80" as="geometry" /></mxCell><mxCell id="lanes6" value="&lt;b&gt;7 × lane&lt;/b&gt; · CB002-24V-573mm&lt;br&gt;24 V · ≤0.2 A idle · 5.8 cm/s · ≤6 kg&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;button + LED per lane, on LANECTRL-06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2930" y="660" width="240" height="80" as="geometry" /></mxCell><mxCell id="lc7" value="&lt;b&gt;LANECTRL-07&lt;/b&gt; · CAN node 7&lt;br&gt;7 × H-bridge + TVS · 7 × feedback · 7 × button + LED on board&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;24 V in (F7) · 12 V via bus cable · front of row&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2570" y="760" width="270" height="80" as="geometry" /></mxCell><mxCell id="lanes7" value="&lt;b&gt;7 × lane&lt;/b&gt; · CB002-24V-573mm&lt;br&gt;24 V · ≤0.2 A idle · 5.8 cm/s · ≤6 kg&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;button + LED per lane, on LANECTRL-07&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2930" y="760" width="240" height="80" as="geometry" /></mxCell><mxCell id="lc8" value="&lt;b&gt;LANECTRL-08&lt;/b&gt; · CAN node 8&lt;br&gt;7 × H-bridge + TVS · 7 × feedback · 7 × button + LED on board&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;24 V in (F8) · 12 V via bus cable · front of row&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2570" y="860" width="270" height="80" as="geometry" /></mxCell><mxCell id="lanes8" value="&lt;b&gt;7 × lane&lt;/b&gt; · CB002-24V-573mm&lt;br&gt;24 V · ≤0.2 A idle · 5.8 cm/s · ≤6 kg&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;button + LED per lane, on LANECTRL-08&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2930" y="860" width="240" height="80" as="geometry" /></mxCell><mxCell id="lc9" value="&lt;b&gt;LANECTRL-09&lt;/b&gt; · CAN node 9&lt;br&gt;7 × H-bridge + TVS · 7 × feedback · 7 × button + LED on board&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;24 V in (F9) · 12 V via bus cable · front of row&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2570" y="960" width="270" height="80" as="geometry" /></mxCell><mxCell id="lanes9" value="&lt;b&gt;7 × lane&lt;/b&gt; · CB002-24V-573mm&lt;br&gt;24 V · ≤0.2 A idle · 5.8 cm/s · ≤6 kg&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;button + LED per lane, on LANECTRL-09&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2930" y="960" width="240" height="80" as="geometry" /></mxCell><mxCell id="lc10" value="&lt;b&gt;LANECTRL-10&lt;/b&gt; · node 10 · bus entry&lt;br&gt;7 × H-bridge + TVS · 7 × feedback · 7 × button + LED on board&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;24 V in (F10) · 12 V via bus cable · front of row&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE3A2B;strokeWidth=2;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2570" y="1060" width="270" height="80" as="geometry" /></mxCell><mxCell id="lanes10" value="&lt;b&gt;7 × lane&lt;/b&gt; · CB002-24V-573mm&lt;br&gt;24 V · ≤0.2 A idle · 5.8 cm/s · ≤6 kg&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7C858E&quot;&gt;button + LED per lane, on LANECTRL-10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2930" y="1060" width="240" height="80" as="geometry" /></mxCell><mxCell id="lane_note" value="LANECTRL = one board per row at the front edge of the row: the 7 lane buttons and 7 LEDs sit on the board behind the lane bezel, the 7 conveyor leads (W27, ferrules into the conveyor 3-pos screw terminal) run back to the conveyors. Row cables: 7 internal + 2 external (24 V feeder from the bus bar, CAN + 12 V bus). CAN + 12 V enters at LANECTRL-10 (nearest the cabinet) and daisy-chains upward; 120 Ω at LANECTRL-01. Lane n → row n ÷ 7, channel n mod 7." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2570" y="1170" width="600" height="80" as="geometry" /></mxCell><mxCell id="legend" value="&lt;font color=&quot;#BE3A2B&quot;&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; DC power only (24 V motor / 12 V logic / 48 V drives, bold) &amp;nbsp;&amp;nbsp;&amp;nbsp; ━━ AC mains / motor phases &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1D5FA8&quot;&gt;━━&lt;/font&gt; data / sensor / control &amp;nbsp;&amp;nbsp;&amp;nbsp; ┄┄ wireless or TBC &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#9A6510&quot;&gt;▭&lt;/font&gt; pending decision" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=#D4D9E0;fillColor=#F0F2F5;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1000" height="40" as="geometry" /></mxCell><mxCell id="tables_ref" value="&lt;b&gt;Tables in Excel:&lt;/b&gt; APDU_Electrical_Tables_R23.xlsx — Connectors, Cables (W01…W34 with lengths), PCBs, Fuses (F1–F17), Power (loads per 24 / 12 / 48 V rail). Labels on this drawing use the same J / W / F numbers." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=#D4D9E0;fillColor=#F7EEDC;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="1390" width="1500" height="40" as="geometry" /></mxCell><mxCell id="e_ac24" value="W01 · AC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=7;strokeColor=#171A1F;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.152;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="acin" target="psu24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ac12" value="W02 · AC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=7;strokeColor=#171A1F;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="acin" target="psu12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ac48" value="W31 · AC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=7;strokeColor=#171A1F;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.848;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="acin" target="psu48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_24dist" value="W03 · 24 V · 20 A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=7;strokeColor=#BE3A2B;strokeWidth