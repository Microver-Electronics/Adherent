        <mxCell id="lane_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" value="LANECTRL = row junction box in the rear 2&quot; channel; 24 V bus bar = F1–F10 feeders; power button + LED on every lane. Per row: 7 × 3-pin conveyor leads + 1 × 16-way Micro-Fit harness to the LANEPANEL front strip (7 momentary power buttons, 7 status LEDs). Row cables: 8 internal + 2 external (24 V feeder from the bus bar, CAN + 12 V bus). Lane n → row n ÷ 7, channel n mod 7. CAN + 12 V enters at LANECTRL-10 (nearest the cabinet) and daisy-chains upward; 120 Ω at LANECTRL-01." vertex="1">
          <mxGeometry height="60" width="440" x="1760" y="848" as="geometry" />
        </mxCell>
        <mxCell id="xstep" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A1F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;" value="&lt;b&gt;X closed-loop stepper + integrated drive&lt;/b&gt;&lt;br&gt;Emtech 57BYG250-76 · 2 N·m · 4 A · brake · 3:1 gearbox&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7C858E&quot;&gt;24–48 V in · STEP/DIR/ENA in · ALARM out · brake 24 V (TBC)&lt;/font&gt;" vertex="1">
