        <mxCell id="conn_table" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;strokeColor=none;fillColor=#FFFFFF;whiteSpace=wrap;overflow=hidden;spacing=4;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;font-family:Helvetica;width:100%;border-color:#BEC5CE&quot;&gt;&lt;tr style=&quot;background:#E7EAEF;font-weight:bold&quot;&gt;&lt;td&gt;Ref&lt;/td&gt;&lt;td&gt;Interface&lt;/td&gt;&lt;td&gt;Board / location&lt;/td&gt;&lt;td&gt;Connector&lt;/td&gt;&lt;td&gt;Board-side MPN&lt;/td&gt;&lt;td&gt;Mating / cable-side MPN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J1&lt;/td&gt;&lt;td&gt;AC mains inlet · filter · switch · fuse&lt;/td&gt;&lt;td&gt;rear panel&lt;/td&gt;&lt;td&gt;IEC C14 power entry module&lt;/td&gt;&lt;td&gt;Schaffner FN9264-6-06&lt;/td&gt;&lt;td&gt;IEC C13 cord set&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J2&lt;/td&gt;&lt;td&gt;Ethernet · hard-wired LAN&lt;/td&gt;&lt;td&gt;rear panel bulkhead&lt;/td&gt;&lt;td&gt;RJ45 feed-through, D-shape&lt;/td&gt;&lt;td&gt;Neutrik NE8FDP&lt;/td&gt;&lt;td&gt;Cat5e / Cat6 patch cord&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J3&lt;/td&gt;&lt;td&gt;Wi-Fi / BT antenna&lt;/td&gt;&lt;td&gt;rear panel&lt;/td&gt;&lt;td&gt;RP-SMA bulkhead + 2.4 / 5 GHz dipole&lt;/td&gt;&lt;td&gt;Taoglas TG.30.8113 (antenna)&lt;/td&gt;&lt;td&gt;U.FL → RP-SMA bulkhead pigtail, 150 mm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F1–F16&lt;/td&gt;&lt;td&gt;24 V + 12 V + 48 V feeders&lt;/td&gt;&lt;td&gt;DIN rail, cabinet&lt;/td&gt;&lt;td&gt;Fuse terminal block 5×20&lt;/td&gt;&lt;td&gt;Phoenix Contact UT 4-HESI (5X20) · 3046032&lt;/td&gt;&lt;td&gt;5×20 fuses per fuse schedule&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J47 / J48&lt;/td&gt;&lt;td&gt;48 V + control at X / Z drive unit&lt;/td&gt;&lt;td&gt;Emtech integrated drive (motor side)&lt;/td&gt;&lt;td&gt;manufacturer connector — TBC from datasheet&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;W31 / W32 power, W11 / W12 control&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J5&lt;/td&gt;&lt;td&gt;24 V motor feeder in (2 + 2 paralleled)&lt;/td&gt;&lt;td&gt;LANECTRL ×10&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 4-pin dual row&lt;/td&gt;&lt;td&gt;Molex 43045-0400&lt;/td&gt;&lt;td&gt;Molex 43025-0400 + 43030-0007 crimp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J6 / J7&lt;/td&gt;&lt;td&gt;CAN + 12 V bus in / out (CAN_H, CAN_L, 12 V, GND, shield)&lt;/td&gt;&lt;td&gt;LANECTRL ×10&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 5-pin single row&lt;/td&gt;&lt;td&gt;Molex 43650-0500&lt;/td&gt;&lt;td&gt;Molex 43645-0500 + 43030-0007 crimp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J45&lt;/td&gt;&lt;td&gt;LANEPANEL ribbon · 7 × button in, 7 × LED out, 3.3 V, GND&lt;/td&gt;&lt;td&gt;LANECTRL ×10 → LANEPANEL ×10&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 16-pin dual row (both ends)&lt;/td&gt;&lt;td&gt;Molex 43045-1600&lt;/td&gt;&lt;td&gt;Molex 43025-1600 + 43030-0007 · 16-way harness&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SW1–7 / D1–7&lt;/td&gt;&lt;td&gt;Lane power button + status LED&lt;/td&gt;&lt;td&gt;LANEPANEL ×10 (front strip)&lt;/td&gt;&lt;td&gt;12 mm tactile pushbutton + 5 mm LED&lt;/td&gt;&lt;td&gt;Omron B3F-4055 · Kingbright WP7113ID&lt;/td&gt;&lt;td&gt;– (PCB-mounted, behind lane bezel)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J8–J14&lt;/td&gt;&lt;td&gt;Conveyor lanes 1–7 · motor +/−, feedback&lt;/td&gt;&lt;td&gt;LANECTRL ×10&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 3-pin single row, 5 A/pin&lt;/td&gt;&lt;td&gt;Molex 43650-0300&lt;/td&gt;&lt;td&gt;Molex 43645-0300 + 43030-0007 · conveyor-side mate: supplier Q6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J15 / J15A&lt;/td&gt;&lt;td&gt;CAN in (from MAINCTRL) / CAN + 12 V out (to lane rows)&lt;/td&gt;&lt;td&gt;SYSCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 4-pin dual / 5-pin single row&lt;/td&gt;&lt;td&gt;Molex 43045-0400 / 43650-0500&lt;/td&gt;&lt;td&gt;Molex 43025-0400 / 43645-0500 + 43030-0007&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J16 / J17&lt;/td&gt;&lt;td&gt;X / Z closed-loop drive control · PUL±, DIR±, ENA±, ALM±, brake +/−&lt;/td&gt;&lt;td&gt;SYSCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 10-pin dual row&lt;/td&gt;&lt;td&gt;Molex 43045-1000&lt;/td&gt;&lt;td&gt;Molex 43025-1000 + 43030-0007 crimp · drive-side mate TBC (Emtech)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J18 / J19&lt;/td&gt;&lt;td&gt;Steppers · chuck rotate, chuck jaws&lt;/td&gt;&lt;td&gt;SYSCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 4-pin, 5 A&lt;/td&gt;&lt;td&gt;Molex 43045-0400&lt;/td&gt;&lt;td&gt;Molex 43025-0400 + 43030-0007 crimp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J20&lt;/td&gt;&lt;td&gt;Basket tilt servo · PWM + 6 V&lt;/td&gt;&lt;td&gt;SYSCTRL → Z carriage&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 3-pin single row&lt;/td&gt;&lt;td&gt;Molex 43650-0300&lt;/td&gt;&lt;td&gt;Molex 43645-0300 + 43030-0007 crimp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J21–J27&lt;/td&gt;&lt;td&gt;Opto sensors ×7 (6 gantry + jaw home)&lt;/td&gt;&lt;td&gt;SYSCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 3-pin single row&lt;/td&gt;&lt;td&gt;Molex 43650-0300&lt;/td&gt;&lt;td&gt;Molex 43645-0300 + 43030-0007 · sensor side: Omron EE-1001 lead re-terminated&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J29&lt;/td&gt;&lt;td&gt;24 V motor supply in (F11)&lt;/td&gt;&lt;td&gt;SYSCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 4-pin dual row (2 × 24 V, 2 × GND paralleled, 10 A)&lt;/td&gt;&lt;td&gt;Molex 43045-0400&lt;/td&gt;&lt;td&gt;Molex 43025-0400 + 43030-0007&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J30–J33&lt;/td&gt;&lt;td&gt;EM latches K1–K4 · 12 V&lt;/td&gt;&lt;td&gt;SYSCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 2-pin&lt;/td&gt;&lt;td&gt;Molex 43045-0200&lt;/td&gt;&lt;td&gt;Molex 43025-0200 + 43030-0007 crimp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J35–J39&lt;/td&gt;&lt;td&gt;Door position sensors ×5&lt;/td&gt;&lt;td&gt;SYSCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 2-pin&lt;/td&gt;&lt;td&gt;Molex 43045-0200&lt;/td&gt;&lt;td&gt;Molex 43025-0200 + 43030-0007&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J41&lt;/td&gt;&lt;td&gt;12 V in (F12) · logic + latch rail&lt;/td&gt;&lt;td&gt;SYSCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 4-pin dual row (2 × 12 V, 2 × GND paralleled, 8 A)&lt;/td&gt;&lt;td&gt;Molex 43045-0400&lt;/td&gt;&lt;td&gt;Molex 43025-0400 + 43030-0007&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J46&lt;/td&gt;&lt;td&gt;12 V in (F13) · on-board 5 V buck&lt;/td&gt;&lt;td&gt;MAINCTRL&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 2-pin (on SBC carrier / power board)&lt;/td&gt;&lt;td&gt;Molex 43045-0200&lt;/td&gt;&lt;td&gt;Molex 43025-0200 + 43030-0007&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J42&lt;/td&gt;&lt;td&gt;CAN master interface&lt;/td&gt;&lt;td&gt;MAINCTRL&lt;/td&gt;&lt;td&gt;SPI CAN FD HAT (MCP2518FD) or USB-CAN adapter&lt;/td&gt;&lt;td&gt;e.g. Waveshare 2-CH CAN FD HAT · or PEAK PCAN-USB&lt;/td&gt;&lt;td&gt;Micro-Fit 3.0 4-pin pigtail to bus · 120 Ω term. here&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J44&lt;/td&gt;&lt;td&gt;OCR camera&lt;/td&gt;&lt;td&gt;MAINCTRL&lt;/td&gt;&lt;td&gt;USB 3.0 Type-A → Micro-B screw-lock&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;camera vendor cable, 1 m&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SWD&lt;/td&gt;&lt;td&gt;Debug / programming&lt;/td&gt;&lt;td&gt;LANECTRL · SYSCTRL (LANEPANEL is passive)&lt;/td&gt;&lt;td&gt;ARM 10-pin 1.27 mm&lt;/td&gt;&lt;td&gt;Samtec FTSH-105-01-L-DV-K&lt;/td&gt;&lt;td&gt;ST-LINK 10-pin ribbon&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="735" width="730" x="2315" y="140" as="geometry" />
        </mxCell>
        <mxCell id="conn_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" value="One connector family on every board I/O: Molex Micro-Fit 3.0 (3 mm pitch, 5 A/pin, 43030-0007 crimp, one crimp tool). Panel parts, DIN fuse terminals and SWD are the only exceptions. CAN bus: one backbone MAINCTRL → SYSCTRL → LANECTRL-01…10, 500 kbit/s, 120 Ω at both ends, ~2 m total. MPNs are Rev A candidates; confirm at BOM v1. Conveyor mating connector waits on supplier question 6." vertex="1">
          <mxGeometry height="32" width="730" x="2315" y="877" as="geometry" />
        </mxCell>
