;tr&gt;&lt;td&gt;W01&lt;/td&gt;&lt;td&gt;WR_ADHERENT_ACIN_TO_PSU24_R1&lt;/td&gt;&lt;td&gt;AC inlet → PSU1&lt;/td&gt;&lt;td&gt;3 × 18 AWG L / N / PE (exception)&lt;/td&gt;&lt;td&gt;ferrule → faston / screw&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W02&lt;/td&gt;&lt;td&gt;WR_ADHERENT_ACIN_TO_PSU12_R1&lt;/td&gt;&lt;td&gt;AC inlet → PSU2&lt;/td&gt;&lt;td&gt;3 × 18 AWG L / N / PE (exception)&lt;/td&gt;&lt;td&gt;ferrule → faston / screw&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W33&lt;/td&gt;&lt;td&gt;WR_ADHERENT_ACIN_TO_PSU48_R1&lt;/td&gt;&lt;td&gt;AC inlet → PSU3 (48 V)&lt;/td&gt;&lt;td&gt;3 × 18 AWG L / N / PE (exception)&lt;/td&gt;&lt;td&gt;ferrule → screw terminal&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W03&lt;/td&gt;&lt;td&gt;WR_ADHERENT_PSU24_TO_DIST_R1&lt;/td&gt;&lt;td&gt;PSU1 → DIN fuse block&lt;/td&gt;&lt;td&gt;2 × 14 AWG red / black, 20 A (exception)&lt;/td&gt;&lt;td&gt;ferrule both ends&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W04&lt;/td&gt;&lt;td&gt;WR_ADHERENT_PSU12_TO_DIST_R1&lt;/td&gt;&lt;td&gt;PSU2 → DIN fuse block&lt;/td&gt;&lt;td&gt;2 × 16 AWG red / black, 12 A (exception)&lt;/td&gt;&lt;td&gt;ferrule both ends&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W34&lt;/td&gt;&lt;td&gt;WR_ADHERENT_PSU48_TO_DIST_R1&lt;/td&gt;&lt;td&gt;PSU3 → DIN fuse block&lt;/td&gt;&lt;td&gt;2 × 16 AWG red / black, 10 A (exception)&lt;/td&gt;&lt;td&gt;ferrule both ends&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W05&lt;/td&gt;&lt;td&gt;WR_ADHERENT_DIST_TO_MAINCTRL_R1&lt;/td&gt;&lt;td&gt;F13 → MAINCTRL J46&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R+Y = 12 V, B+G = GND&lt;/td&gt;&lt;td&gt;ferrule → Micro-Fit 2-pin&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W06&lt;/td&gt;&lt;td&gt;WR_ADHERENT_DIST_TO_SYSCTRL_24V_R1&lt;/td&gt;&lt;td&gt;F11 → SYSCTRL J29 (chuck steppers)&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R+Y = 24 V, B+G = GND (6 A)&lt;/td&gt;&lt;td&gt;ferrule → Micro-Fit 4-pin (2 + 2)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W07&lt;/td&gt;&lt;td&gt;WR_ADHERENT_DIST_TO_SYSCTRL_12V_R1&lt;/td&gt;&lt;td&gt;F12 → SYSCTRL J41&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R+Y = 12 V, B+G = GND&lt;/td&gt;&lt;td&gt;ferrule → Micro-Fit 4-pin (2 + 2)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W31&lt;/td&gt;&lt;td&gt;WR_ADHERENT_DIST_TO_XDRIVE_48V_R1&lt;/td&gt;&lt;td&gt;F15 → X drive unit power&lt;/td&gt;&lt;td&gt;2 × 16 AWG red / black, 48 V 5 A (exception)&lt;/td&gt;&lt;td&gt;ferrule → drive terminal (TBC)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.2&lt;/td&gt;&lt;td&gt;1.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W32&lt;/td&gt;&lt;td&gt;WR_ADHERENT_DIST_TO_ZDRIVE_48V_R1&lt;/td&gt;&lt;td&gt;F16 → Z drive unit power (via X chain)&lt;/td&gt;&lt;td&gt;2 × 16 AWG red / black, 48 V 5 A, flex (exception)&lt;/td&gt;&lt;td&gt;ferrule → drive terminal (TBC)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W08&lt;/td&gt;&lt;td&gt;WR_ADHERENT_MAINCTRL_TO_SYSCTRL_R1&lt;/td&gt;&lt;td&gt;MAINCTRL J42 → SYSCTRL J15 (CAN)&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G shielded · Y = CAN_H, G = CAN_L, B = GND, R = n/c&lt;/td&gt;&lt;td&gt;Micro-Fit 4 ↔ Micro-Fit 4&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W09&lt;/td&gt;&lt;td&gt;WR_ADHERENT_MAINCTRL_TO_RJ45_R1&lt;/td&gt;&lt;td&gt;MAINCTRL → rear RJ45 bulkhead&lt;/td&gt;&lt;td&gt;Cat6 patch (exception)&lt;/td&gt;&lt;td&gt;RJ45 ↔ RJ45&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W10&lt;/td&gt;&lt;td&gt;WR_ADHERENT_MAINCTRL_TO_ANT_R1&lt;/td&gt;&lt;td&gt;MAINCTRL → RP-SMA bulkhead&lt;/td&gt;&lt;td&gt;coax pigtail (exception)&lt;/td&gt;&lt;td&gt;U.FL ↔ RP-SMA&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;0.3&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W11&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_XDRIVE_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J16 → X drive control&lt;/td&gt;&lt;td&gt;3 × 4c 22 AWG R-B-Y-G loom: (PUL+ PUL− DIR+ DIR−) (ENA+ ENA− ALM+ ALM−) (brake 24 V R/B, Y/G spare)&lt;/td&gt;&lt;td&gt;Micro-Fit 10 → drive connector (TBC)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.2&lt;/td&gt;&lt;td&gt;1.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W12&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_ZDRIVE_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J17 → Z drive control (via X chain)&lt;/td&gt;&lt;td&gt;3 × 4c 22 AWG R-B-Y-G loom, flex, same pin-out as W11&lt;/td&gt;&lt;td&gt;Micro-Fit 10 → drive connector (TBC)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W13&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_SERVO_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J20 → tilt servo (via X + Z chains)&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R = 6.8 V, B = GND, Y = PWM, G = spare&lt;/td&gt;&lt;td&gt;Micro-Fit 3 → Micro-Fit 3 (servo 300 mm lead re-terminated)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;3.8&lt;/td&gt;&lt;td&gt;3.8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W14&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_JBGANTRY_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J21–J26 → JB-GANTRY (column base)&lt;/td&gt;&lt;td&gt;3 × 4c 22 AWG R-B-Y-G loom · each: R = +12 V, B = GND, Y/G = 2 sensor outputs&lt;/td&gt;&lt;td&gt;Micro-Fit 3 ×6 → ferrule + WAGO 221&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;2.0&lt;/td&gt;&lt;td&gt;2.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W15&lt;/td&gt;&lt;td&gt;WR_ADHERENT_JBGANTRY_TO_SENSn_R1&lt;/td&gt;&lt;td&gt;JB-GANTRY → 6 × EE-SX67x-WR&lt;/td&gt;&lt;td&gt;sensor 1 m 4-core robot cable (brown Vcc, blue 0 V, black OUT, pink L to 0 V or open)&lt;/td&gt;&lt;td&gt;ferrule + WAGO 221 ← sensor lead&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;1.0&lt;/td&gt;&lt;td&gt;6.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W16&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_CHUCKROT_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J18 → chuck rotate stepper&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G shielded · R/B = phase A, Y/G = phase B&lt;/td&gt;&lt;td&gt;Micro-Fit 4 → crimp to motor leads&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W17&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_CHUCKJAW_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J19 → chuck jaw stepper&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G shielded · R/B = phase A, Y/G = phase B&lt;/td&gt;&lt;td&gt;Micro-Fit 4 → crimp to motor leads&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W18&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_JAWSENS_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J27 → jaw home sensor&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R = +V, B = GND, Y = out, G = spare&lt;/td&gt;&lt;td&gt;Micro-Fit 3 → sensor lead&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W19&lt;/td&gt;&lt;td&gt;WR_ADHERENT_MAINCTRL_TO_CAM_R1&lt;/td&gt;&lt;td&gt;MAINCTRL → OCR camera&lt;/td&gt;&lt;td&gt;USB 3.0 A → Micro-B screw-lock (exception)&lt;/td&gt;&lt;td&gt;moulded&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W20&lt;/td&gt;&lt;td&gt;WR_ADHERENT_MAINCTRL_TO_MARKER_R1&lt;/td&gt;&lt;td&gt;MAINCTRL → label marker&lt;/td&gt;&lt;td&gt;USB or Cat6 (exception, TBC)&lt;/td&gt;&lt;td&gt;moulded&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W21&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_LATCH12_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J30/J31 → K1 main + K2 retrieval latch&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R/B = K1, Y/G = K2&lt;/td&gt;&lt;td&gt;Micro-Fit 4 → 2 × Micro-Fit 2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.8&lt;/td&gt;&lt;td&gt;1.8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W22&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_LATCH34_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J32/J33 → K3 return + K4 table latch&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R/B = K3, Y/G = K4&lt;/td&gt;&lt;td&gt;Micro-Fit 4 → 2 × Micro-Fit 2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;td&gt;1.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W23&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_JBDOORS_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J35–J39 → JB-DOORS&lt;/td&gt;&lt;td&gt;2 × 4c 22 AWG R-B-Y-G · B = GND common, R/Y/G = 3 inputs each&lt;/td&gt;&lt;td&gt;Micro-Fit 2 ×5 → ferrule + WAGO 221&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1.2&lt;/td&gt;&lt;td&gt;1.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W24&lt;/td&gt;&lt;td&gt;WR_ADHERENT_JBDOORS_TO_DOORSENSn_R1&lt;/td&gt;&lt;td&gt;JB-DOORS → 5 door sensors&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G (R = signal, B = GND, Y/G spare)&lt;/td&gt;&lt;td&gt;ferrule + WAGO 221 → sensor&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;1.0&lt;/td&gt;&lt;td&gt;5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W25&lt;/td&gt;&lt;td&gt;WR_ADHERENT_DIST_TO_LANECTRLnn_R1&lt;/td&gt;&lt;td&gt;F1–F10 → LANECTRL-01…10 J5&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R+Y = 24 V, B+G = GND (2 × 22 AWG per pole, 5 A)&lt;/td&gt;&lt;td&gt;ferrule (fuse block) → Micro-Fit 4 (2 + 2)&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;1.6&lt;/td&gt;&lt;td&gt;16.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W26&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_LANECTRL10_R1&lt;/td&gt;&lt;td&gt;SYSCTRL J15A → LANECTRL-10 J6&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G shielded · R = 12 V, B = GND, Y = CAN_H, G = CAN_L&lt;/td&gt;&lt;td&gt;Micro-Fit 5 ↔ Micro-Fit 5 (pin 5 = shield)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.9&lt;/td&gt;&lt;td&gt;0.9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W27&lt;/td&gt;&lt;td&gt;WR_ADHERENT_LANECTRLnn_TO_LANECTRLmm_R1&lt;/td&gt;&lt;td&gt;LANECTRL-10 → 09 → … → 01 (J7 → J6)&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G shielded · R = 12 V, B = GND, Y = CAN_H, G = CAN_L&lt;/td&gt;&lt;td&gt;Micro-Fit 5 ↔ Micro-Fit 5&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;0.3&lt;/td&gt;&lt;td&gt;2.7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W28&lt;/td&gt;&lt;td&gt;WR_ADHERENT_LANECTRLnn_TO_LANEm_R1&lt;/td&gt;&lt;td&gt;LANECTRL J8–J14 → 7 conveyors per row&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G · R = M+, B = M−, Y = feedback, G = spare&lt;/td&gt;&lt;td&gt;Micro-Fit 3 → conveyor mate (supplier Q6)&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;35.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W29&lt;/td&gt;&lt;td&gt;WR_ADHERENT_LANECTRLnn_TO_LANEPANELnn_R1&lt;/td&gt;&lt;td&gt;LANECTRL J45 → LANEPANEL&lt;/td&gt;&lt;td&gt;4 × 4c 22 AWG R-B-Y-G loom (16 wires: 7 buttons, 7 LEDs, 3.3 V, GND)&lt;/td&gt;&lt;td&gt;Micro-Fit 16 ↔ Micro-Fit 16&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;0.9&lt;/td&gt;&lt;td&gt;9.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;W30&lt;/td&gt;&lt;td&gt;WR_ADHERENT_SYSCTRL_TO_DOORACT_R1&lt;/td&gt;&lt;td&gt;SYSCTRL spare → future door actuators&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G (TBD with actuator set)&lt;/td&gt;&lt;td&gt;Micro-Fit 2 → TBD&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;TBD&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#E7EAEF;font-weight:bold&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;Totals&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;4c 22 AWG R-B-Y-G stock incl. 20 % service: ≈ 153 m&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;138&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;105&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontFamily=Helvetica;strokeColor=none;fillColor=#FFFFFF;whiteSpace=wrap;overflow=hidden;spacing=4;" vertex="1" parent="1"><mxGeometry x="3095" y="140" width="870" height="900" as="geometry" /></mxCell><mxCell id="cable_note" value="&lt;b&gt;Cable rule:&lt;/b&gt; default cable is 4-conductor 22 AWG, red-black-yellow-green, Micro-Fit 3.0 crimp + housing at every board end. Cables landing in a junction box (JB-GANTRY, JB-DOORS) get hex ferrules and WAGO 221 lever terminals. Exceptions (mains, 20 A / 12 A / 10 A feeds, USB, Ethernet, coax) are marked. W31 / W32 / W11 / W12 end connectors wait for the Emtech drive datasheet. W25 length is the average of the 10 rows (0.8 m bottom row → 2.4 m top row). Lengths are routing estimates; confirm on the harness drawings." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=#D4D9E0;fillColor=#F7EEDC;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3080" y="1065" width="900" height="70" as="geometry" /></mxCell><mxCell id="e_ac48" value="W33 · AC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=6;strokeColor=#171A1F;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.907;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="acin" target="psu48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_48dist" value="W34 · 48 V · 10 A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=6;strokeColor=#BE3A2B;endArrow=block;endFill=1;strokeWidth=3;endSize=8;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#BE3A2B;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="psu48" target="dist"><mxGeometry relative="1" as="geometry" x="0.801"><Array as="points"><mxPoint x="420" y="285" /><mxPoint x="420" y="648" /></Array></mxGeometry></mxCell><mxCell id="e_48z" value="W32 · 48 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=6;strokeColor=#BE3A2B;endArrow=block;endFill=1;strokeWidth=3;endSize=8;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#BE3A2B;exitX=0.85;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="dist" target="zstep"><mxGeometry relative="1" as="geometry" x="0.555"><Array as="points"><mxPoint x="897" y="948" /><mxPoint x="1632" y="948" /><mxPoint x="1632" y="192" /></Array></mxGeometry></mxCell><mxCell id="e_48x" value="W31 · 48 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=6;strokeColor=#BE3A2B;endArrow=block;endFill=1;strokeWidth=3;endSize=8;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#BE3A2B;exitX=0.85;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="dist" target="xstep"><mxGeometry relative="1" as="geometry" x="0.202"><Array as="points"><mxPoint x="897" y="948" /><mxPoint x="1642" y="948" /><mxPoint x="1642" y="239" /><mxPoint x="1265" y="239" /></Array></mxGeometry></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>