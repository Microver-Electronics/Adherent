        <mxCell id="lane_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4A5158;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;" value="LANECTRL = row junction box in the rear 2&quot; channel. Per row: 7 × 3-pin conveyor leads + 1 × 16-way Micro-Fit harness to the LANEPANEL front strip (7 momentary power buttons, 7 status LEDs). Row cables: 8 internal + 2 external (24 V feeder, CAN + 12 V bus). Lane n → row n ÷ 7, channel n mod 7. CAN daisy-chains row to row; 120 Ω at row 10." vertex="1">
          <mxGeometry height="60" width="440" x="1020" y="848" as="geometry" />
        </mxCell>
