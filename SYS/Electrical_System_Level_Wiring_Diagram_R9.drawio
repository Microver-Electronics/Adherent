        <mxCell id="e_doorsens" edge="1" parent="1" source="doorsens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D5FA8;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=1;entryY=0.7;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1D5FA8;" target="motion" value="5 × dry contact">
